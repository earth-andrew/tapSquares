  ]

  let delimiter detect-delimiter scoringFunctionFileName
  set scoringInputs (csv:from-file scoringFunctionFileName delimiter)
  set scoringPropertyLabels item 0 scoringInputs
  foreach but-first scoringInputs [ ?0 ->

    let currentFunction ?0

    create-scoringFunctions 1 [
      (foreach scoringPropertyLabels currentFunction [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 and (?1 = "phase" or ?1 = "round_play") [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          set currentParameter (word "set " ?1 " (list " ?2 ")" )
          run currentParameter
          set parameterHandled 1
        ]

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  output-print "scoring function file read."

end


to read-initial-condition-file

  if not file-exists? initialConditionListFileName [
    user-message "Please enter valid file name for initial conditions data"
    stop
  ]

  let delimiter detect-delimiter initialConditionListFileName
  set icInputs (csv:from-file initialConditionListFileName delimiter)
  set icPropertyLabels item 0 icInputs
  foreach but-first icInputs [ ?0 ->

    let currentIC ?0

    create-ICs 1 [
      (foreach icPropertyLabels currentIC [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 and (?1 = "onlyIf" or ?1 = "notIf") [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          set currentParameter (word "set " ?1 " (list " ?2 ")" )
          run currentParameter
          set parameterHandled 1
        ]

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  output-print "initial condition file read."

end


to set-initial-conditions
  ;; unchanged from tapSquares -- applies each loaded IC row to a
  ;; probability-selected subset of patches

  foreach sort-on [conditionID] ICs [
    currentCondition ->

    let currentVariable [variable] of currentCondition
    let currentType [conditionType] of currentCondition
    let currentProbability [probability] of currentCondition
    let currentOnlyIf [onlyIf] of currentCondition
    let currentNotIf [notIf] of currentCondition
    let currentValueMode [valueMode] of currentCondition
    let currentValueExpression [valueExpression] of currentCondition
    let currentMin [minValue] of currentCondition
    let currentMax [maxValue] of currentCondition

    let allowedPatches patches with [inGame?]

    foreach currentOnlyIf [
      currentReporter ->
      set allowedPatches allowedPatches with [ runresult currentReporter ]
    ]

    foreach currentNotIf [
      currentReporter ->
      set allowedPatches allowedPatches with [ not runresult currentReporter ]
    ]

    let currentCount round (currentProbability * count allowedPatches)

    if any? allowedPatches [
      ask n-of min (list (count allowedPatches) currentCount) allowedPatches [

        if currentValueMode = "fixed" [
          run (word "set " currentVariable " " currentValueExpression)
        ]

        if currentValueMode = "expression" [
          let currentValue runresult currentValueExpression
          run (word "set " currentVariable " " currentValue)
        ]

        if currentValueMode = "uniform" [
          let low currentMin
          let high currentMax
          if is-string? low [ set low runresult low ]
          if is-string? high [ set high runresult high ]
          let currentValue low + random-float (high - low)
          run (word "set " currentVariable " " currentValue)
        ]

        if currentValueMode = "integer" [
          let low currentMin
          let high currentMax
          if is-string? low [ set low runresult low ]
          if is-string? high [ set high runresult high ]
          let currentValue low + random (high - low + 1)
          run (word "set " currentVariable " " currentValue)
        ]
      ]
    ]
  ]
end


;; ============================================================================
;; ENGINE -- reused from tapSquares, with one ABM-specific change: round_play
;; ============================================================================

;; round_play in actionList.csv/spatialFunctionList.csv/scoringFunction.csv is
;; authored against the *human game*'s round count (e.g. "1 2 3" for a game
;; that only ever runs 3 rounds there) -- for the ABM, which exists to
;; extrapolate longer and bigger than any human playtest, currentRound is not
;; a real predictor of behavior, just an artifact of however many rounds the
;; original game happened to have. Treating round_play as an exact-membership
;; list (the human template's behavior) would make everything silently and
;; permanently ineligible the moment the ABM runs past whatever round the
;; game file's author last bothered to list -- which is exactly what
;; happened in the Lantana test (actions/degradation both authored to
;; "1 2 3", ABM run past round 3, everyone stalled with no error).
;;
;; The one exception: round_play = [0] is a deliberate one-time-setup
;; sentinel (e.g. assign-elephants, run once during setup at currentRound 0)
;; and must keep exact-match semantics so it fires once and never again.
;; Everything else is "ongoing" and should stay eligible for every round
;; from its start round onward, gated only by phase and flags (real state),
;; not by which literal round number it is.
to-report round-eligible? [roundList]
  ;; a blank round_play cell parses to an empty list -- keep that as "never
  ;; eligible" (matching the old exact-membership behavior for that case)
  ;; rather than erroring on (min []).
  if empty? roundList [report false]
  ifelse member? 0 roundList [
    report member? currentRound roundList
  ][
    report currentRound >= (min roundList)
  ]
end

to run-non-spatial-functions
  foreach sort-on [functionID] nonSpatialFunctions [ currentNonSpatialFunction ->
    ask currentNonSpatialFunction [
      if (member? currentPhase phase) and (round-eligible? round_play) [
        run expression
      ]
    ]
  ]
end


to run-spatial-functions
  foreach sort-on [functionID] spatialFunctions [ currentSpatialFunction ->
    ask currentSpatialFunction [
      if member? currentPhase phase and round-eligible? round_play [
        let currentTrigger trigger
        let currentLocalVariables localVariables
        let currentLocalTargets localTargets
        let currentExpression expression
        let currentX xOffset
        let currentY yOffset

        ask patches with [inGame?] [
          if runresult currentTrigger [
            if length currentLocalVariables > 0 [
              (foreach currentLocalVariables currentLocalTargets [ [a b] -> run (word "set " a " " b)] )
            ]

            if (not (patch-at currentX currentY = nobody)) [
              ask patch-at currentX currentY [run currentExpression]
            ]
          ]
        ]
      ]
    ]
  ]
end


to update-choices-patches
  ;; computes, for every in-game patch, the list of every currently-valid
  ;; actionID (including -99, "do nothing") given round/phase/flags --
  ;; independent of any player or agent

  ask patches with [inGame?] [
    set landChoices []
    set landChoices lput -99 landChoices

    foreach sort-on [actionID] actions [
      currentAction -> ask currentAction [

        let validAction true
        if not (member? currentPhase phaseAvailable and round-eligible? round_play) [set validAction false]

        foreach flags [ currentFlag -> if not [runresult currentFlag] of myself [set validAction false] ]

        if validAction [let myID actionID ask myself [set landChoices lput myID landChoices]]
      ]
    ]
  ]
end


to update-patch-image

  ask visuals-here [die]

  ifelse currentChoice > 0 [
    let myChoice currentChoice
    sprout-visuals 1 [
      set size 1
      set shape [imageName] of one-of actions with [actionID = myChoice]
    ]
    ask ownerBoxes-here [set color item (([selectedBy] of patch-here) - 1) playerColor set hidden? false]
    ask displayTurtles-here with [transparent? = TRUE] [ palette:set-transparency 90 ]
  ][
    ask ownerBoxes-here [set hidden? true]
    ask displayTurtles-here with [transparent? = TRUE] [ palette:set-transparency 0 ]

    let bestMatchState 0
    foreach sort-on [stateID] landStates [ currentLandState ->
      let currentFlags [flags] of currentLandState
      let tempMatch true
      if length currentFlags > 0 [
        foreach currentFlags [ tempFlag -> if (not runresult tempFlag) [set tempMatch false] ]
      ]
      if tempMatch [set bestMatchState [stateID] of currentLandState]
    ]

    if bestMatchState > 0 [
      let currentVisual one-of landStates with [stateID = bestMatchState]
      if not empty? [imageName] of currentVisual [
        sprout-visuals 1 [
          set size 1
          set shape [imageName] of currentVisual
          if not empty? [stateColor] of currentVisual [
            set color runresult ([stateColor] of currentVisual)
          ]
        ]
      ]
    ]

    foreach sort-on [turtleID] landDisplays [ currentTurtle ->
      let currentCount [countMeasure] of currentTurtle
      set currentCount runresult currentCount
      let currentMobile [mobile?] of currentTurtle
      let currentTransparent [transparent?] of currentTurtle

      (ifelse is-list? currentCount [
        foreach n-values numPlayers [ ?1 -> ?1 ] [ ?1 ->
          let currentPlayerCount item ?1 currentCount
          if currentPlayerCount > 0 [
            let currentID [turtleID] of currentTurtle
            let currentNeeds currentPlayerCount - count displayTurtles-here with [identity = currentID]
            sprout-displayTurtles currentNeeds [
              setxy (pxcor - 0.5 + random-float 1) (pycor - 0.5 + random-float 1)
              set size [turtleSizeMin] of currentTurtle + (random-float 1) * ([turtleSizeMax - turtleSizeMin] of currentTurtle)
              set shape [imageName] of currentTurtle
              set identity ([turtleID] of currentTurtle)
              set mobile? currentMobile
              set transparent? currentTransparent
              set owner ?1 + 1
              set color item ?1 playerColor
            ]
          ]
        ]
      ]
        is-number? currentCount [
          if currentCount > 0 [
            let currentID [turtleID] of currentTurtle
            let currentNeeds currentCount - count displayTurtles-here with [identity = currentID]
            sprout-displayTurtles currentNeeds [
              setxy (pxcor - 0.5 + random-float 1) (pycor - 0.5 + random-float 1)
              set size [turtleSizeMin] of currentTurtle + (random-float 1) * ([turtleSizeMax - turtleSizeMin] of currentTurtle)
              set shape [imageName] of currentTurtle
              set identity ([turtleID] of currentTurtle)
              set transparent? currentTransparent
              set mobile? currentMobile
            ]
          ]
        ]
      )
    ]
  ]
end


to-report update-patch-color
  let scaler 1
  if not is-empty-safe? patch_color_property
    [set scaler ifelse-value (is-string? patch_color_property) [runresult patch_color_property] [patch_color_property]]

  let currentColor 0
  if inGame? [
    let currentRGB_R max (list 0 (min (list 255 ((item 0 patch_color_min) + scaler * (item 0 patch_color_max - item 0 patch_color_min)))))
    let currentRGB_G max (list 0 (min (list 255 ((item 1 patch_color_min) + scaler * (item 1 patch_color_max - item 1 patch_color_min)))))
    let currentRGB_B max (list 0 (min (list 255 ((item 2 patch_color_min) + scaler * (item 2 patch_color_max - item 2 patch_color_min)))))

    ifelse selected? [
      set currentColor (list (currentRGB_R * selected_shading) (currentRGB_G * selected_shading) (currentRGB_B * selected_shading) )
    ] [
      set currentColor (list currentRGB_R currentRGB_G currentRGB_B)
    ]
  ]

  report currentColor
end


to-report is-empty-safe? [ input ]
  ifelse is-list? input or is-string? input
    [ report empty? input ]
    [ report false ] ; Numbers, booleans, and agentsets return false
end


to-report detect-delimiter [filename]
  let comma-rows []
  let semicolon-rows []

  carefully [ set comma-rows (csv:from-file filename ",") ] [ ]
  carefully [ set semicolon-rows (csv:from-file filename ";") ] [ ]

  if empty? comma-rows and empty? semicolon-rows [
    error (word "Could not read CSV file: " filename)
  ]
  if empty? comma-rows [ report ";" ]
  if empty? semicolon-rows [ report "," ]
  if length first semicolon-rows > length first comma-rows [ report ";" ]
  report ","
end


to make-borders
  ask patches with [pxcor >= 0 and pycor < max-pycor] [
    sprout-borders 1 [set color border_color
      setxy pxcor pycor + 0.5
      set heading 90
      stamp die]
  ]
  ask patches with [pxcor >= 0 and pxcor < max-pxcor] [
    sprout-borders 1 [set color border_color
      setxy pxcor + 0.5 pycor
      set heading 0
      stamp die]
  ]
end


;; ============================================================================
;; VILLAGE/PRIVATE LAND -- autonomous equivalent of the human clicking-flow
;; ============================================================================

;; make-private-borders and make-shared-borders are ported verbatim from
;; tapSquares_template_v1.2 -- generic border-drawing utilities, not
;; specific to human vs. autonomous play.

to make-private-borders [stamp?]
  ;; make border around each player's owned patches
  ;; do this using 'border' agents that stamp an image of themselves between patches and then die
  ;; note: if you have wraparound, the setxy line has to be modified to account for this

  ask patches with [ownedBy > 0] [
    let currentOwner ownedBy
    let x1 pxcor
    let y1 pycor

    sprout-displayTurtles 1 [set mobile? false set size 0.2 setxy pxcor - 0.25 pycor + 0.25 set shape "circle" set color (item (currentOwner - 1) playerColor)]

    ask neighbors4 [
      let x2 pxcor
      let y2 pycor
      let neighborOwner ownedBy
      if neighborOwner != currentOwner [
        sprout-borders 1 [set color (item (currentOwner - 1) playerColor)
          setxy mean (list x1 x2) mean (list y1 y2)
          ifelse y1 != y2 [set heading 90] [set heading 0]

          if stamp?
          [stamp die]]
      ]
    ]
  ]
end

to make-shared-borders [borderShape borderColor compareFlag stamp?]
  ;; make border around areas used by one village
  ;; do this using 'border' agents that stamp an image of themselves between patches and then die
  ;; note: if you have wraparound, the setxy line has to be modified to account for this

  ask patches with [inGame?] [
    let x1 pxcor
    let y1 pycor
    let currentFlag runresult compareFlag

    let conditionMet false
    ;;run for this patch if the flag is numeric and defined (above 0), or if the flag is boolean and true
    if is-boolean? currentFlag [if currentFlag [set conditionMet true]]
    if is-number? currentFlag [if currentFlag > 0 [set conditionMet true]]
    if conditionMet [

      ask neighbors4 [
        let x2 pxcor
        let y2 pycor
        let neighborFlag runresult compareFlag

        if currentFlag != neighborFlag [
          sprout-borders 1 [set color borderColor
            set shape borderShape
            set identity compareFlag
            setxy mean (list x1 x2) mean (list y1 y2)
            (ifelse
              y1 < y2 [set heading 270]
              y1 > y2 [set heading 90]
              x1 < x2 [set heading 0]
              x1 > x2 [set heading 180]
              )

            if stamp? [
              stamp die]
          ]
        ]
      ]
    ]
  ]
end

to randomly-assign-villages
  ;; Random-seed-then-spread flood-fill (same algorithm game details.nls's
  ;; randomly-assign-landscape uses for individual ownership, one level up
  ;; -- villages instead of players), BUT stops once villageCoverageTarget's
  ;; fraction of the board is claimed, rather than filling every patch.
  ;; villageCoverageTarget defaults to 1 (whole board, the old unconditional
  ;; behavior) unless setup has estimated or been given a lower value --
  ;; see villageCoverageTarget's declaration and setup's use of
  ;; estimate-village-coverage-from-log. Growing outward one patch at a
  ;; time (rather than a full simultaneous wavefront each step) is what
  ;; lets this stop right at the target instead of overshooting it.

  ;; villageMembership (from sessionList.csv) maps each player (1-indexed) to
  ;; a village number -- needed here (before finish-village-assignment) just
  ;; to know how many villages to seed.
  if numPlayers > length villageMembership [
    user-message (word "villageMembership only has " length villageMembership
      " entries, but numAgents is " numPlayers ". Add more entries to "
      "villageMembership in sessionList.csv, or reduce numAgents.")
    stop
  ]
  let numVillages max (sublist villageMembership 0 numPlayers)

  ask patches with [inGame?] [set village -99]
  let villageTick 1
  ask n-of numVillages patches with [inGame?] [
    set village villageTick
    set villageTick villageTick + 1
  ]

  let targetClaimed round (villageCoverageTarget * (count patches with [inGame?]))
  while [
    (count patches with [inGame? and village > 0]) < targetClaimed
    and any? patches with [inGame? and village <= 0 and any? neighbors4 with [inGame? and village > 0]]
  ] [
    ask one-of patches with [inGame? and village <= 0 and any? neighbors4 with [inGame? and village > 0]] [
      set village [village] of one-of (neighbors4 with [inGame? and village > 0])
    ]
  ]

  finish-village-assignment
end

to-report estimate-village-coverage-from-log [logFileName]
  ;; A SCALABLE property of a real played session's village layout: what
  ;; fraction of the board ended up claimed by some village, vs. left open/
  ;; unclaimed -- a plain fraction, so it carries over to a board of any
  ;; size, unlike the literal patch-by-patch layout (which wouldn't mean
  ;; anything on a differently-sized board).
  ;;
  ;; Every round logs a full STATE|...|village|... snapshot of every
  ;; in-game patch (not just changed ones), so "the last round's snapshot"
  ;; is well-defined: keep a running (round, totalPatches, claimedPatches)
  ;; and reset the counts every time a NEW HIGHER round number is seen, so
  ;; what's left once the file is fully read is exactly the final round's
  ;; tally -- no separate pass needed to first find the max round.

  if not file-exists? logFileName [
    user-message (word "estimate-village-coverage-from-log: can't find " logFileName)
    report -1
  ]

  let currentMaxRound -1
  let totalPatches 0
  let claimedPatches 0

  file-open logFileName
  while [not file-at-end?] [
    let currentLine file-read-line
    let fields split-log-line currentLine
    if length fields >= 7 and item 0 fields = "STATE" and item 5 fields = "village" [
      let logRound read-from-string (item 1 fields)
      if logRound > currentMaxRound [
        set currentMaxRound logRound
        set totalPatches 0
        set claimedPatches 0
      ]
      if logRound = currentMaxRound [
        set totalPatches totalPatches + 1
        if (read-from-string (item 6 fields)) > 0 [
          set claimedPatches claimedPatches + 1
        ]
      ]
    ]
  ]
  file-close

  if totalPatches = 0 [
    user-message (word "estimate-village-coverage-from-log: no STATE|...|village|... lines found in " logFileName)
    report -1
  ]

  report claimedPatches / totalPatches
end

to-report split-log-line [line]
  ;; minimal "|"-delimited split -- STATE|round|phase|x|y|name|value has no
  ;; embedded pipes or quoting to worry about, so plain position/substring
  ;; is all this needs.
  let fields []
  let remaining line
  while [position "|" remaining != false] [
    set fields lput (substring remaining 0 (position "|" remaining)) fields
    set remaining substring remaining ((position "|" remaining) + 1) (length remaining)
  ]
  report lput remaining fields
end

to finish-village-assignment
  ;; Called by randomly-assign-villages once village is set (to whatever
  ;; extent villageCoverageTarget calls for) on the board's patches -- wires
  ;; up the rest: which players can access which village, and the border
  ;; drawing. villageMembership (sessionList.csv) maps each player
  ;; (1-indexed) to a village number.
  if numPlayers > length villageMembership [
    user-message (word "villageMembership only has " length villageMembership
      " entries, but numAgents is " numPlayers ". Add more entries to "
      "villageMembership in sessionList.csv, or reduce numAgents.")
    stop
  ]
  let shortVillageMembership sublist villageMembership 0 numPlayers
  let numVillages max shortVillageMembership
  set villageMemberList n-values numVillages [[]]
  let all-indices range length shortVillageMembership
  foreach n-values numVillages [i -> i + 1] [i ->
    set villageMemberList (replace-item (i - 1) villageMemberList
      map [j2 -> j2 + 1] (filter [j -> item j shortVillageMembership = i] all-indices))
  ]

  ;; only patches with a real, in-range village number belong to one --
  ;; unclaimed patches (village <= 0, whether because randomly-assign-
  ;; villages was never run against them or because a real session
  ;; genuinely left them unclaimed) are left at their setup default
  ;; (every player has access) rather than narrowed to any village, i.e.
  ;; open/common access, not "belongs to nobody so nobody can use it."
  ask patches with [inGame? and village > 0 and village <= length villageMemberList] [
    set shared? true
    set playerAccess item (village - 1) villageMemberList
  ]

  make-shared-borders "line-thick" village_border_color "village" false
end

to randomly-assign-private-land
  ;; each player claims up to maxPrivateSquares patches at random -- scoped
  ;; to their own village if chooseVillageLand? is also true (matching the
  ;; human template's "private land must be within your village" rule),
  ;; otherwise from the whole board. Not a contiguous claim -- the human
  ;; flow lets a player tap any patch they can reach, not just adjacent
  ;; ones, so n-of (a plain random subset) matches that more faithfully
  ;; than flood-filling would.
  ask patches with [inGame?] [set ownedBy -99]

  foreach playerPosition [ p ->
    let myVillage 0
    if chooseVillageLand? [ set myVillage item (p - 1) villageMembership ]

    let eligiblePatches patches with [inGame? and ownedBy = -99 and (myVillage <= 0 or village = myVillage)]
    let claimCount min (list maxPrivateSquares (count eligiblePatches))

    if claimCount > 0 [
      ask n-of claimCount eligiblePatches [set ownedBy p]
    ]
  ]

  make-private-borders false
end


to end-game
  set gameInProgress 0
  file-close
  ask patches with [inGame?] [ask turtles-here [die] set pcolor black]
end


;; ============================================================================
;; BEHAVIOR-WEIGHTS LOADING
;; ============================================================================

to read-behavior-file

  if not file-exists? behaviorListFileName [
    user-message (word "Behavior-weights file not found: " behaviorListFileName
      ". Run the R notebook's export step first.")
    stop
  ]

  let delimiter detect-delimiter behaviorListFileName
  set behaviorInputs (csv:from-file behaviorListFileName delimiter)
  set behaviorPropertyLabels item 0 behaviorInputs

  foreach but-first behaviorInputs [ currentRow ->
    create-behaviors 1 [
      set hidden? true
      (foreach behaviorPropertyLabels currentRow [ [lbl val] ->
        ifelse is-string? val [
          set tempValue remove "\\" val
          run (word "set " lbl " tempValue")
        ][
          run (word "set " lbl " " val)
        ]
      ])
    ]
  ]

  output-print (word "Loaded " count behaviors " behavior-weight rows from " behaviorListFileName
    " (" length remove-duplicates [agent_type] of behaviors " agent type(s)).")

  ;; The reference/baseline action: a multinomial logit's reference level
  ;; never gets its own row in coef(), so it has no rows in the exported
  ;; weights file either -- its score is implicitly 0 and everything else
  ;; is a log-odds relative to it. Read explicitly from the R notebook's
  ;; export rather than inferred (comparing outcome_option against the full
  ;; action list would be fragile).
  set referenceActionID ""
  ifelse file-exists? referenceActionFileName [
    let refDelimiter detect-delimiter referenceActionFileName
    let refInputs (csv:from-file referenceActionFileName refDelimiter)
    set referenceActionID item 0 (item 1 refInputs)
    output-print (word "Reference (baseline) action for scoring: actionID = " referenceActionID)
  ][
    user-message (word "Reference-action file not found: " referenceActionFileName
      ". Every action will be scored as if it has real fitted weights, with no "
      "zero baseline -- re-run the R notebook's export step (Step 9) to regenerate it.")
  ]

end


to read-outcome-plot-file
  ;; OPTIONAL. Populates the "Custom Outcomes" plot with whatever game-
  ;; specific series a session wants to track, without this file needing to
  ;; know anything about them ahead of time -- same generic CSV-driven
  ;; pattern as every other read-X-file procedure. Each row's "reporter"
  ;; column is a full NetLogo reporter expression string, already including
  ;; its own aggregation (e.g. "sum [harvestYield] of patches with
  ;; [inGame?]" or "count displayTurtles with [shape = \"elephant\"]") --
  ;; update-abm-plots just runresult's it once per completed phase and plots
  ;; the value under that row's label. "penColor" is optional -- a bare
  ;; NetLogo color reporter as text (e.g. "blue", "orange + 1"); left
  ;; blank, NetLogo picks a default color for the pen.
  ;;
  ;; Completely optional: if outcomePlotListFileName is blank/unset or the
  ;; file doesn't exist, this is skipped and the Custom Outcomes plot just
  ;; stays empty -- see setup-abm-plots.

  let delimiter detect-delimiter outcomePlotListFileName
  set outcomePlotInputs (csv:from-file outcomePlotListFileName delimiter)
  set outcomePlotPropertyLabels item 0 outcomePlotInputs

  foreach but-first outcomePlotInputs [ currentRow ->
    create-outcomePlots 1 [
      set hidden? true
      (foreach outcomePlotPropertyLabels currentRow [ [lbl val] ->
        ifelse is-string? val [
          set tempValue remove "\\" val
          run (word "set " lbl " tempValue")
        ][
          run (word "set " lbl " " val)
        ]
      ])
    ]
  ]

  output-print (word "Loaded " count outcomePlots " custom outcome-plot series from " outcomePlotListFileName ".")
end


;; ============================================================================
;; PLOTTING
;; ============================================================================

to setup-abm-plots
  ;; NOTE: named setup-abm-plots, not setup-plots -- setup-plots is also a
  ;; reserved NetLogo primitive, same as update-plots above.
  ;;
  ;; called once from setup. Resets every plot and (re)creates pens so
  ;; repeated Setup presses in the same NetLogo session don't accumulate
  ;; duplicate points or duplicate temporary pens.

  set plotStep 0

  set-current-plot "Player Score"
  clear-plot

  set-current-plot "Player Resources"
  clear-plot

  set-current-plot "Actions Taken"
  clear-plot

  set outcomePlotsLoaded? false
  set-current-plot "Custom Outcomes"
  clear-plot
  if is-string? outcomePlotListFileName and outcomePlotListFileName != "" and file-exists? outcomePlotListFileName [
    read-outcome-plot-file
    foreach sort-on [plotID] outcomePlots [ currentOutcomePlot ->
      ask currentOutcomePlot [
        create-temporary-plot-pen plotLabel
        if is-string? penColor and penColor != "" [
          set-plot-pen-color runresult penColor
        ]
      ]
    ]
    set outcomePlotsLoaded? true
  ]
end


to update-abm-plots
  ;; NOTE: named update-abm-plots, not update-plots -- update-plots is a
  ;; reserved NetLogo primitive (redraws plots from their own update code)
  ;; and can't be redefined.
  ;;
  ;; called once per completed phase, from advance-to-next-round, while
  ;; currentRound/currentPhase still describe the phase that just finished.

  set plotStep plotStep + 1

  set-current-plot "Player Score"
  set-current-plot-pen "current score"
  plotxy plotStep (mean playerCurrentScore)
  set-current-plot-pen "total score"
  plotxy plotStep (mean playerTotalScore)

  set-current-plot "Player Resources"
  set-current-plot-pen "avg resources"
  plotxy plotStep (mean playerCurrentResources)

  set-current-plot "Actions Taken"
  set-current-plot-pen "actions this phase"
  plotxy plotStep (count patches with [inGame? and currentChoice != -99])

  if outcomePlotsLoaded? [
    set-current-plot "Custom Outcomes"
    foreach sort-on [plotID] outcomePlots [ currentOutcomePlot ->
      ask currentOutcomePlot [
        set-current-plot-pen plotLabel
        plotxy plotStep (runresult reporter)
      ]
    ]
  ]
end


;; ============================================================================
;; SETUP
;; ============================================================================

to setup
  ;; no parameter -- numAgents is a global (interface slider), read
  ;; directly below, same as patches_game already was. Passing it in as an
  ;; argument was redundant now that it's a real global rather than a
  ;; literal hardcoded on the button.

  if numAgents > length colorList [
    user-message (word "numAgents (" numAgents ") exceeds colorList's "
      length colorList " entries. Add more colors to colorList (in prepare-session) or reduce numAgents.")
    stop
  ]

  if (length currentSessionParameters = 0) [
    user-message "No session parameters loaded. Run \"Read Session File\" then \"Initialize Session\" first (with sessionParameters pointed at sessionList_ABM.csv and sessionID set to match)."
    stop
  ]

  clear-output
  clear-patches
  clear-turtles
  clear-drawing
  set gameInProgress 0

  ;; build a synthetic roster
  set playerNames []
  set playerPosition []
  set playerColor []
  set numPlayers 0
  foreach n-values numAgents [i -> i + 1] [i ->
    set playerNames lput (word "Farmer" i) playerNames
    set numPlayers numPlayers + 1
    set playerPosition lput numPlayers playerPosition
    set playerColor lput (item (numPlayers - 1) colorList) playerColor
  ]

  set playerConfirm n-values numPlayers [0]
  set playerCurrentScore n-values numPlayers [0]
  set playerCurrentResources n-values numPlayers [endowment]   ;; placeholder -- reset once endowment is known below, same as tapSquares' own start-game
  set playerTotalScore n-values numPlayers [0]

  set-initial-player-conditions   ;; game-specific, game details.nls

  ;; the output file has to be open before set-game-parameters runs -- it
  ;; (and every read-X-file procedure below) calls file-print to log each
  ;; parameter as it's applied, same as tapSquares' own start-game
  let tempDate date-and-time
  foreach [2 5 8 12 15 18 22] [ ?1 -> set tempDate replace-item ?1 tempDate "_" ]
  set gameName (word gameID "_ABM_" numAgents "agents_" tempDate ".csv")
  carefully [file-delete gameName file-open gameName] [file-open gameName]
  output-print (word "output file created: " gameName)

  set-game-parameters

  ;; if sessionList.csv points villageAssignmentSource at a real played
  ;; session, ESTIMATE villageCoverageTarget from it (what fraction of the
  ;; board ended up claimed by some village there), overriding any literal
  ;; villageCoverageTarget column set-game-parameters already applied above.
  ;; Only include villageAssignmentSource in a game's sessionList.csv row if
  ;; you want the estimate to win; a game that wants to set the fraction by
  ;; hand should simply not include that column at all.
  if is-string? villageAssignmentSource and villageAssignmentSource != "" and file-exists? villageAssignmentSource [
    let estimatedCoverage estimate-village-coverage-from-log villageAssignmentSource
    if estimatedCoverage >= 0 [
      set villageCoverageTarget estimatedCoverage
      output-print (word "villageCoverageTarget estimated from " villageAssignmentSource ": " estimatedCoverage)
    ]
  ]

  ;; MUST run before the read-*-file calls below: resize-world clears
  ;; every turtle (like clear-all, scoped to the world/turtles) whenever
  ;; the requested dimensions actually differ from the world's current
  ;; size. The readers create their data-holding turtles (actions,
  ;; landStates, landDisplays, ICs, spatialFunctions,
  ;; nonSpatialFunctions) -- if resize-world ran after them and the
  ;; world size wasn't already exactly patches_game, every one of those
  ;; would be silently wiped, leaving setup looking like it worked
  ;; (no error) but with nothing actually loaded. Confirmed as the
  ;; cause of "brown screen on the first Setup after changing
  ;; patches_game/numAgents off their defaults, fine on a
  ;; retry (the world's already the new size by then, so the second
  ;; resize-world is a no-op)."
  ;;
  ;; the whole world is playable -- no control panel to lay out around
  resize-world 0 (patches_game - 1) 0 (patches_game - 1)

  ;; resize-world alone keeps patch size fixed and grows the view's on-
  ;; screen pixel footprint with it -- at patches_game's upper end that
  ;; view would be huge. set-patch-size keeps the on-screen viewport a
  ;; constant ~600x600 regardless of patches_game, by shrinking/growing
  ;; each patch to fit -- same physical size and shape on screen whether
  ;; the world is 4x4 or 30x30.
  set-patch-size (600 / patches_game)

  read-action-file
  read-state-file
  read-turtle-file
  read-spatial-function-file
  read-non-spatial-function-file
  read-scoring-function-file
  read-initial-condition-file

  ask patches [
    set selected? false
    set inGame? true
    set playerAccess n-values numPlayers [i -> i + 1]
    set currentChoice -99
    set ownedBy -99
    sprout-ownerBoxes 1 [set color red set hidden? true]
    set-initial-patch-conditions   ;; game-specific, game details.nls
  ]

  set-additional-game-level-conditions   ;; game-specific, game details.nls
  set-initial-conditions

  ;; autonomous equivalent of the human game's village/private land-picking
  ;; phases -- villages first (private land, if also chosen, is scoped to
  ;; whichever village each player landed in). randomly-assign-villages now
  ;; reads villageCoverageTarget (set above from villageAssignmentSource, or
  ;; from a literal sessionList.csv column, or left at its default of 1) to
  ;; decide how much of the board villages actually claim -- a scalable
  ;; PROPERTY of a real session rather than its literal layout, so a game
  ;; where unclaimed/open land matters keeps that property at any board size.
  if chooseVillageLand? [
    randomly-assign-villages
  ]
  if choosePrivateLand? [
    randomly-assign-private-land
  ]

  ;; NOT redundant with the later coloring pass below, despite looking
  ;; like it: this is what actually SPAWNS displayTurtles (elephants,
  ;; crops, etc.) via update-patch-image's countMeasure-driven sprout
  ;; logic, from the elephantCount/cropCount/etc. that
  ;; set-initial-conditions just assigned. It has to run before
  ;; run-non-spatial-functions, below, because round_play=0 functions
  ;; like assign-elephants need those turtles to already exist -- a
  ;; prior attempt to remove this as "redundant" broke exactly that
  ;; (elephants spawned with no herd assignment, crashing move-elephants
  ;; the first time it ran). The later pass re-draws after spatial/non-
  ;; spatial functions have run; this one has to happen first so those
  ;; functions have something to act on.
  ask patches with [inGame?] [update-patch-image set pcolor update-patch-color]
  make-borders

  ;; currentRound must be 0 AND currentPhase must be 1 for this first
  ;; run-non-spatial-functions/run-spatial-functions call -- matches
  ;; tapSquares' own start-game, which sets both before its first call to
  ;; these two procedures (some functions, e.g. assign-elephants, are
  ;; scheduled for round_play = 0 and phase = 1, and are gated on BOTH
  ;; matching -- currentPhase left at NetLogo's default (0) would silently
  ;; skip them even with currentRound correct). setup doesn't clear-all
  ;; (that would also wipe the loaded session/colorList), so neither value
  ;; would otherwise be reset if Setup gets pressed more than once in the
  ;; same NetLogo session.
  set currentRound 0
  set currentPhase 1
  run-non-spatial-functions
  run-spatial-functions

  ;; In the human template, currentPhase only ever reaches 2 during setup
  ;; via a SECOND land-confirmation transition: choosing village land
  ;; confirms at phase 1 (the call just above), then -- only if the game
  ;; ALSO uses private land -- currentPhase increments to 2 and a second
  ;; run-non-spatial-functions/run-spatial-functions call fires when
  ;; private land is confirmed (see advance-to-next-round, Case 1 then
  ;; Case 2, in tapSquares_template.nlogox). A game with round_play=0
  ;; functions scheduled for phase 2 relies on that second call -- e.g.
  ;; Crouching Tiger's initial animal placement (nonSpatialFunctionList
  ;; row 1, round_play=0 phase=2) never ran here, because this setup
  ;; auto-assigns village/private land in one shot (randomly-assign-
  ;; villages/randomly-assign-private-land, above) and previously only
  ;; ever called these procedures once, at phase 1 -- silently skipping
  ;; every phase-2 setup-time function with no error (confirmed live:
  ;; animals never appeared on the board). A game that only uses one of
  ;; village/private land, or neither, never reaches phase 2 in the human
  ;; template either, so this call is skipped for those, matching exactly.
  if chooseVillageLand? and choosePrivateLand? [
    set currentPhase 2
    run-non-spatial-functions
    run-spatial-functions
    set currentPhase 1
  ]

  set currentRound 1
  set currentPhase 1
  output-print " BEGINNING LAND USE PHASES"
  file-print (word "PHASE|beginning-land-use|" date-and-time)

  update-choices-patches
  set playerCurrentResources n-values numPlayers [endowment]

  ask patches with [inGame?] [
    update-patch-image
    set pcolor update-patch-color
  ]

  reset-ticks   ;; tick counter, visible via the "ticks" monitor -- go calls tick once per round/phase it advances

  set gameInProgress 1

  set warnedNoTapAnalog false
  set warnedUnresolvedFeatures []
  set featureResolutionCache table:make
  read-behavior-file

  let availableClasses remove-duplicates [agent_type] of behaviors
  set agentClassList n-values numPlayers [one-of availableClasses]

  (foreach playerPosition agentClassList [ [agentNum cls] ->
    output-print (word "Farmer" agentNum " assigned behavior class: " cls)
  ])

  output-print (word "ABM roster ready: " numPlayers " autonomous farmers on a "
    patches_game "x" patches_game " board.")

  setup-abm-plots
end


;; ============================================================================
;; DECISION POLICY
;; ============================================================================

;; get-feature-value is called every scored feature, every candidate
;; action, every agent, every tick -- a very hot path. Classifying a
;; feature name (backtick-quoted? bare TRUE/FALSE? categorical dummy?
;; which candidate variable name actually resolves?) requires live
;; runresult/carefully probing, including probing attempts that fail --
;; expensive in NetLogo (runresult recompiles the string every call, and
;; a failed attempt inside carefully is costlier still). But which
;; classification applies to a given featureName string never changes
;; once determined, so it's classified ONCE per distinct featureName and
;; cached in featureResolutionCache; every later call for that same name
;; skips straight to a single live value lookup, which is the only part
;; that must re-run every time (the underlying variable's value changes
;; patch to patch / tick to tick).
to-report get-feature-value [featureName]
  ;; Must be called BY A PATCH (i.e. from inside "ask <patch> [...]" or
  ;; "of <patch>"), since most features resolve as patches-own variables.
  ;; currentABMAgent must already be set to the agent currently being
  ;; scored, for the player-level features below.

  if not table:has-key? featureResolutionCache featureName [
    table:put featureResolutionCache featureName (classify-feature-name featureName)
  ]
  let recipe table:get featureResolutionCache featureName
  let recipeType item 0 recipe
  let candidateName item 1 recipe
  let levelSuffix item 2 recipe

  if recipeType = "intercept"     [ report 1 ]
  if recipeType = "current-score" [ report item (currentABMAgent - 1) playerCurrentScore ]
  if recipeType = "total-score"   [ report item (currentABMAgent - 1) playerTotalScore ]
  if recipeType = "resources"     [ report item (currentABMAgent - 1) playerCurrentResources ]

  if recipeType = "no-tap-analog" [
    if not warnedNoTapAnalog [
      output-print (word "note: feature '" featureName "' measured human tap/retap "
        "behavior and has no autonomous-agent equivalent -- treated as 0 in every score "
        "from here on.")
      set warnedNoTapAnalog true
    ]
    report 0
  ]

  if recipeType = "unresolved" [
    if not member? featureName warnedUnresolvedFeatures [
      output-print (word "note: feature '" featureName "' couldn't be resolved to any "
        "patch/player variable or recognized dummy-coding pattern -- treated as 0 from here on.")
      set warnedUnresolvedFeatures lput featureName warnedUnresolvedFeatures
    ]
    report 0
  ]

  ;; Everything else needs exactly one live lookup on the (now known-
  ;; correct) candidateName -- the value changes over the run, so this
  ;; part alone can't be cached.
  let resolvedOK false
  let actualValue 0
  carefully [
    set actualValue runresult candidateName
    set resolvedOK true
  ][ ]
  if not resolvedOK [ report 0 ]  ;; shouldn't happen given how classify-feature-name validated it, but stay safe

  if recipeType = "direct"    [ report actualValue ]
  if recipeType = "bool-true"  [ report ifelse-value actualValue [1] [0] ]
  if recipeType = "bool-false" [ report ifelse-value actualValue [0] [1] ]
  ;; "categorical" -- compare as text, since the underlying variable is
  ;; typically numeric (e.g. ownedBy = 2 vs. level "2").
  report ifelse-value ((word actualValue) = levelSuffix) [1] [0]
end


;; One-time classification for a given featureName string. Returns
;; (list recipeType candidateName levelSuffix) -- candidateName/
;; levelSuffix are "" when not applicable to that recipeType. Does the
;; same cascade get-feature-value always did, just once per distinct
;; name instead of once per call.
to-report classify-feature-name [featureName]
  if featureName = "(Intercept)" [ report (list "intercept" "" "") ]
  if featureName = "currentScore" [ report (list "current-score" "" "") ]
  if featureName = "totalScore"   [ report (list "total-score" "" "") ]
  if featureName = "resources"    [ report (list "resources" "" "") ]
  if featureName = "n_taps_patch" or featureName = "n_taps_turn" [ report (list "no-tap-analog" "" "") ]

  ;; R names a logical (TRUE/FALSE) predictor's coefficient as
  ;; `varname`LEVEL -- backtick-quoted because tapSquares booleans are
  ;; named with a trailing "?", which isn't a valid bare R identifier.
  if (length featureName > 0) and (first featureName = "`") [
    let closeBacktickPos position "`" (but-first featureName)
    ifelse closeBacktickPos = false [
      report (list "unresolved" "" "")   ;; malformed/unrecognized backtick-quoted term
    ][
      let closeBacktick 1 + closeBacktickPos
      let innerName substring featureName 1 closeBacktick
      let levelSuffix substring featureName (closeBacktick + 1) (length featureName)
      let resolvedOK false
      let actualValue 0
      carefully [
        set actualValue runresult innerName
        set resolvedOK true
      ][ ]
      ifelse not resolvedOK [
        report (list "unresolved" "" "")
      ][
        ;; Backtick-quoting only means "this name needed quoting" -- it
        ;; does NOT guarantee the underlying variable is actually
        ;; boolean, so check rather than assume.
        ifelse is-boolean? actualValue [
          report (list (ifelse-value (levelSuffix = "TRUE") ["bool-true"] ["bool-false"]) innerName "")
        ][
          report (list "categorical" innerName levelSuffix)
        ]
      ]
    ]
  ]

  ;; R also dummy-codes a logical predictor whose base name is ALREADY a
  ;; valid bare R identifier as plain <varname>TRUE / <varname>FALSE.
  if (length featureName > 4) and (substring featureName (length featureName - 4) (length featureName) = "TRUE") [
    let candidateName substring featureName 0 (length featureName - 4)
    let resolvedOK false
    let candidateValue 0
    carefully [
      set candidateValue runresult candidateName
      if is-boolean? candidateValue [ set resolvedOK true ]
    ][ set resolvedOK false ]
    if resolvedOK [ report (list "bool-true" candidateName "") ]
  ]
  if (length featureName > 5) and (substring featureName (length featureName - 5) (length featureName) = "FALSE") [
    let candidateName substring featureName 0 (length featureName - 5)
    let resolvedOK false
    let candidateValue 0
    carefully [
      set candidateValue runresult candidateName
      if is-boolean? candidateValue [ set resolvedOK true ]
    ][ set resolvedOK false ]
    if resolvedOK [ report (list "bool-false" candidateName "") ]
  ]

  ;; Plain exact-match case: featureName IS a real bare variable name
  ;; as-is (a numeric predictor used directly, not dummy-coded).
  let resolvedDirect false
  carefully [
    let probe runresult featureName
    set resolvedDirect true
  ][ ]
  if resolvedDirect [ report (list "direct" featureName "") ]

  ;; General categorical (non-boolean) dummy-coding fallback: R names a
  ;; factor predictor's coefficient <varname><level> with no separator
  ;; -- e.g. ownership variables like "village" or "ownedBy", dummy-
  ;; coded as "village1", "village0", "ownedBy2", etc. The split point
  ;; isn't marked, so try every split from the longest plausible
  ;; variable-name prefix down to the shortest, and stop at the first
  ;; one that resolves to a real value at all.
  let splitPos (length featureName) - 1
  while [splitPos > 0] [
    let candidateName substring featureName 0 splitPos
    let levelSuffix substring featureName splitPos (length featureName)
    let resolvedOK false
    carefully [
      let probe runresult candidateName
      set resolvedOK true
    ][ ]
    if resolvedOK [ report (list "categorical" candidateName levelSuffix) ]
    set splitPos splitPos - 1
  ]

  ;; Nothing above resolved this feature -- a genuinely unrecognized
  ;; name (the game changed since the model was fit, a typo, etc.).
  report (list "unresolved" "" "")
end


to-report score-action-for-agent [candidateActionID myClass]
  ;; Must be called BY A PATCH. Returns this patch's fitted score for
  ;; candidateActionID under behavior class myClass -- log-odds relative to
  ;; referenceActionID, which is defined as scoring exactly 0.

  if (word candidateActionID) = (word referenceActionID) [ report 0 ]

  let matchingRows behaviors with [
    agent_type = myClass and decision_stage = "action_choice"
    and (word outcome_option) = (word candidateActionID)
  ]

  if not any? matchingRows [ report 0 ]

  ;; Pull each matching row's (feature, weight) pair out as plain data
  ;; while self is still a behaviorRow (feature/weight are behaviorRow's
  ;; own variables) -- "of" on an agentset returns a list of per-agent
  ;; results without touching the caller's own agent context. self stays
  ;; the ORIGINAL calling patch for everything below, since nothing here
  ;; uses "ask" or "of" on a single agent -- get-feature-value must run
  ;; with self = that patch (it reads patches-own variables), and calling
  ;; it via "[get-feature-value feature] of thisPatch" turned out to still
  ;; leave self as the behaviorRow, not the patch (confirmed by a real
  ;; runtime error: "this code can't be run by a patch, only by a turtle",
  ;; reported while a behaviorrow was running GET-FEATURE-VALUE).
  let featureWeightPairs [(list feature weight)] of matchingRows

  let runningScore 0
  foreach featureWeightPairs [ pair ->
    let featureVal get-feature-value (item 0 pair)
    let rawWeight item 1 pair
    ;; weight should always load as a number, but scientific notation
    ;; (e.g. "2.9e-4", common in these exported coefficients) is worth
    ;; guarding rather than trusting -- coerce defensively if csv:from-file
    ;; ever hands it back as text instead of a number
    let weightVal ifelse-value (is-string? rawWeight) [read-from-string rawWeight] [rawWeight]
    set runningScore runningScore + weightVal * featureVal
  ]
  report runningScore
end


to choose-actions-for-agent [agentNum]

  ;; Greedy choice over every (patch, action) pair this agent can afford,
  ;; best margin over "do nothing" first, stopping when nothing left beats
  ;; doing nothing or the budget runs out.
  ;;
  ;; Once a patch has been assigned an action this turn by this agent, it's
  ;; not reconsidered for a different action the same turn (a real patch
  ;; could otherwise be double-charged effort if revisited). Contention
  ;; with OTHER agents over shared land is preserved exactly as tapSquares
  ;; already implements it -- once any agent selects a patch, other agents
  ;; skip it until the next phase resets selected?.
  ;;
  ;; PERFORMANCE: this used to re-score every (patch, action) pair on EVERY
  ;; greedy pick (up to 50 picks), rescanning the whole board each time --
  ;; O(patches x actions x iterations), which is what made this crawl as
  ;; patches_game/numAgents scaled up. But a patch's score for a given
  ;; action never changes over the course of one agent's turn (it only
  ;; depends on the patch's own state and this agent's class, neither of
  ;; which other picks affect) -- only whether it's still affordable does.
  ;; So score everything ONCE, sort by margin, and walk the sorted list
  ;; once, skipping anything already claimed or no longer affordable. Same
  ;; picks, same order, one scoring pass instead of up to fifty.

  set currentABMAgent agentNum
  let myClass item (agentNum - 1) agentClassList

  ;; scope this agent to their own village, if villages are in play --
  ;; randomly-assign-villages sets every in-game patch's village to a real
  ;; (positive) number, so without this check village would be drawn/
  ;; bordered but have no actual effect on which patches an agent can act on.
  let myVillage 0
  if chooseVillageLand? [ set myVillage item (agentNum - 1) villageMembership ]

  ;; Compare every real action against THIS PATCH's own fitted "do
  ;; nothing" (-99) score, not a shared constant. -99 has its own real
  ;; fitted weights in the behavior file (same as every other outcome) --
  ;; it is not automatically "whatever scores <= 0". The reference action
  ;; (referenceActionID) is fixed at exactly 0 by construction (that's
  ;; what being the multinomial reference means), so comparing it against
  ;; a flat "> 0" threshold could never select it even when the model
  ;; clearly favors it over every other option, including doing nothing.
  ;; Comparing margins (action score minus this patch's -99 score) fixes
  ;; both problems: the reference action can now win when the fitted
  ;; model favors it, and "do nothing" is judged on its own real weights
  ;; rather than an arbitrary baseline.
  let candidates []   ;; each entry: (list margin patch action requiredEffort)

  ask patches with [inGame? and not selected? and (ownedBy <= 0 or ownedBy = agentNum) and (myVillage <= 0 or village = myVillage)] [
    let doNothingScore score-action-for-agent -99 myClass
    let thisPatch self
    foreach landChoices [ candidateAction ->
      if candidateAction > 0 [
        let requiredEffort ifelse-value (is-number? [effort] of one-of actions with [actionID = candidateAction])
          [[effort] of one-of actions with [actionID = candidateAction]]
          [runresult ([effort] of one-of actions with [actionID = candidateAction])]
        let thisMargin (score-action-for-agent candidateAction myClass) - doNothingScore
        if thisMargin > 0 [
          set candidates lput (list thisMargin thisPatch candidateAction requiredEffort) candidates
        ]
      ]
    ]
  ]

  set candidates sort-by [ [a b] -> (item 0 a) > (item 0 b) ] candidates

  let budgetRemaining item (agentNum - 1) playerCurrentResources

  foreach candidates [ candidateRow ->
    let thisPatch item 1 candidateRow
    let thisAction item 2 candidateRow
    let thisEffort item 3 candidateRow

    if (not [selected?] of thisPatch) and (thisEffort <= budgetRemaining) [
      ask thisPatch [
        set currentChoice thisAction
        set selected? true
        set selectedBy agentNum
        set currentEffort thisEffort

        update-all-resources (agentNum - 1)
        update-patch-image
        set pcolor update-patch-color

        file-print (word "CHOICE|" currentRound "|" currentPhase "|" agentNum "|" pxcor "|" pycor "|" thisAction "|" date-and-time)
      ]
      set budgetRemaining budgetRemaining - thisEffort
    ]
  ]

end


;; ============================================================================
;; SCORING / ROUND ADVANCEMENT
;; ============================================================================

to update-all-resources [playerNumber]
  let currentSpending sum [currentEffort] of patches with [inGame? and selectedBy = (playerNumber + 1)]
  let currentBudget endowment - currentSpending
  set playerCurrentResources replace-item playerNumber playerCurrentResources currentBudget
end


to run-score-function

  set playerCurrentScore n-values numPlayers [0]

  foreach sort-on [scoreID] scoringFunctions [ currentScoreFunction ->
    ask currentScoreFunction [
      if (member? currentPhase phase) and (round-eligible? round_play) [
        let currentProperty property
        let currentValue value
        if is-string? currentValue [set currentValue runresult currentValue]
        let currentLocalTarget localTarget
        let currentPlayerTarget playerTarget
        let currentOperation operation
        let currentPlayerMarker playerMarker
        let currentTrigger trigger
        let currentLoop? loop?
        let currentPatchLevel? patchLevel?

        if-else currentPatchLevel? [
          ask patches with [inGame?] [

            let runPatch true
            if not empty? currentTrigger [
              if not runresult currentTrigger [set runPatch false]
            ]

            if runPatch [
              if-else currentLoop? [
                foreach n-values (numPlayers) [?1 -> ?1] [ playerNumber ->
                  let currentScore 0
                  if not empty? currentProperty [
                    set currentScore runresult (word "item " playerNumber " " currentProperty)
                  ]
                  if currentScore = true [set currentScore 1]
                  if currentScore = false [set currentScore 0]
                  set currentScore currentScore * currentValue

                  if not empty? currentLocalTarget [
                    (ifelse
                      currentOperation = "add" [
                        run (word "set tempValue item " playerNumber " " currentLocalTarget)
                        run (word "set " currentLocalTarget " replace-item " playerNumber " " currentLocalTarget " (tempValue + " currentScore ")")
                      ]
                      currentOperation = "set" [
                        run (word "set " currentLocalTarget " replace-item " playerNumber " " currentLocalTarget " " currentScore)
                      ]
                    )
                  ]

                  if not empty? currentPlayerTarget [
                    (ifelse
                      currentOperation = "add" [
                        set tempValue 0
                        run (word "set tempValue item " playerNumber " " currentPlayerTarget)
                        run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " (tempValue + " currentScore ")")
                      ]
                      currentOperation = "set" [
                        run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " " currentScore)
                      ]
                    )
                  ]
                ]
              ][
                let currentScore 0
                if not empty? currentProperty [
                  set currentScore runresult currentProperty
                ]
                if currentScore = true [set currentScore 1]
                if currentScore = false [set currentScore 0]
                set currentScore currentScore * currentValue

                if not empty? currentLocalTarget [
                  (ifelse
                    currentOperation = "add" [
                      run (word "set " currentLocalTarget " " currentLocalTarget " + " currentScore)
                    ]
                    currentOperation = "set" [
                      run (word "set " currentLocalTarget " " currentScore)
                    ]
                  )
                ]

                if not empty? currentPlayerTarget [
                  let currentSelector runresult currentPlayerMarker
                  (ifelse
                    currentOperation = "add" [
                      set tempValue 0
                      run (word "set tempValue item " (currentSelector - 1) " " currentPlayerTarget)
                      run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " (tempValue + " currentScore ")")
                    ]
                    currentOperation = "set" [
                      run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " " currentScore)
                    ]
                  )
                ]
              ]
            ]
          ]

        ][ ;; else block for patchLevel? -- non-patch-level scoring

          if-else currentLoop? [
            foreach n-values (numPlayers) [?1 -> ?1] [ playerNumber ->
              let currentScore 0
              if not empty? currentProperty [
                set currentScore runresult (word "item " playerNumber " " currentProperty)
              ]
              if currentScore = true [set currentScore 1]
              if currentScore = false [set currentScore 0]
              set currentScore currentScore * currentValue

              if not empty? currentPlayerTarget [
                (ifelse
                  currentOperation = "add" [
                    set tempValue 0
                    run (word "set tempValue item " playerNumber " " currentPlayerTarget)
                    run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " (tempValue + " currentScore ")")
                  ]
                  currentOperation = "set" [
                    run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " " currentScore)
                  ]
                )
              ]
            ]
          ][
            let currentScore 0
            if not empty? currentProperty [
              set currentScore runresult currentProperty
            ]
            if currentScore = true [set currentScore 1]
            if currentScore = false [set currentScore 0]
            set currentScore currentScore * currentValue

            if not empty? currentPlayerTarget [
              let currentSelector runresult currentPlayerMarker
              (ifelse
                currentOperation = "add" [
                  set tempValue 0
                  run (word "set tempValue item " (currentSelector - 1) " " currentPlayerTarget)
                  run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " (tempValue + " currentScore ")")
                ]
                currentOperation = "set" [
                  run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " " currentScore)
                ]
              )
            ]
          ]
        ]
      ]
    ]
  ]

  foreach n-values (numPlayers) [?1 -> ?1] [ ?1 ->
    let currentScore item ?1 playerTotalScore
    set playerTotalScore replace-item ?1 playerTotalScore (currentScore + item ?1 playerCurrentScore)
  ]

end


to confirm-actions [agentNum]

  set playerConfirm replace-item (agentNum - 1) playerConfirm 1

  if sum playerConfirm = numPlayers [
    advance-to-next-round
  ]

end


to advance-to-next-round
  ;; called once per phase, once every agent has "confirmed." Runs the
  ;; environmental/spatial/scoring functions, logs SCORE| and STATE| lines,
  ;; and moves on to the next phase (or round, or ends the game). There is
  ;; no village/private-land handling and no information-screen handling
  ;; here -- see the note at the top of this file.

  run-non-spatial-functions
  run-spatial-functions

  run-score-function

  foreach n-values numPlayers [i -> i] [i ->
    file-print (word "SCORE|" currentRound "|" currentPhase "|" (i + 1) "|" (item i playerCurrentScore) "|" (item i playerTotalScore) "|" (item i playerCurrentResources))
  ]

  update-abm-plots

  update-choices-patches

  ask patches with [inGame?] [
    set currentChoice -99
    set selectedBy -99
    set selected? false
  ]

  ask patches with [inGame?] [
    update-patch-image
    set pcolor update-patch-color
  ]
  ask displayTurtles with [not mobile?] [set hidden? false]
  ask borders [set hidden? false]

  set currentPhase (currentPhase + 1)
  if currentPhase > numPhases [
    set currentPhase 1
    set currentRound (currentRound + 1)
  ]

  update-choices-patches
  set playerCurrentResources n-values numPlayers [endowment]

  ;; land ownership/access (ownedBy, village, shared?) is core mechanism
  ;; state, not a game-specific variable like a game's own patchPropertyList
  ;; entries -- guaranteed into every STATE| log here regardless of whether
  ;; a given game's own game details.nls remembers to list it.
  ;; remove-duplicates means a game that already lists one of these just
  ;; gets it once, not double-logged.
  let corePatchProperties ["ownedBy" "village" "shared?"]
  ;; patchPropertyList is only ever populated if a game's own game
  ;; details.nls sets it in set-additional-game-level-conditions. A game
  ;; that leaves it unset (including the blank starter template) still has
  ;; the NetLogo default value for an unset global, the number 0, not an
  ;; empty list -- sentence-ing that into corePatchProperties would put a
  ;; literal 0 into allPatchProperties, and runresult-ing that crashes.
  let gamePatchPropertyList (ifelse-value (is-list? patchPropertyList) [patchPropertyList] [[]])
  let allPatchProperties remove-duplicates (sentence corePatchProperties gamePatchPropertyList)
  foreach n-values (length allPatchProperties) [i -> i] [i ->
    ask patches with [inGame?] [
      file-print (word "STATE|" currentRound "|" currentPhase "|" pxcor "|" pycor "|" (item i allPatchProperties) "|" (runresult (item i allPatchProperties)))
    ]
  ]

  foreach playerPosition [ ?1 -> update-all-resources (?1 - 1) ]

  set playerConfirm n-values numPlayers [0]

  ;; the ABM runs for exactly as many rounds as the game itself was
  ;; authored for (numRounds, from sessionList.csv) -- same as a human
  ;; playthrough. Want a longer or shorter run? Change numRounds in
  ;; sessionList.csv, not a slider (see the note on numRounds/numPhases in
  ;; globals[], above, for why this is deliberately a file edit and not an
  ;; interface control).
  if currentRound > numRounds [
    end-game
    stop
  ]

end


;; ============================================================================
;; AUTONOMOUS ROUND LOOP
;; ============================================================================

;; Go is a forever button (see widgets) -- one round/phase per call, one
;; tick per call, so NetLogo's own forever-button behavior (click to
;; start repeating, click again to pause) is the play/pause control, and
;; the tick counter is directly meaningful to watch. The run stops when
;; the game's own numRounds is exceeded (see advance-to-next-round) --
;; same as a human playthrough, no separate ABM-only run-length control.
to go

  if gameInProgress = 0 [
    user-message "Run setup first."
    stop
  ]

  let roundBefore currentRound
  let phaseBefore currentPhase

  ;; every agent picks its actions, then every agent "confirms" -- this
  ;; always advances straight to the next round/phase once everyone's
  ;; confirmed, so exactly one round/phase advances per call.
  foreach playerPosition [ agentNum -> choose-actions-for-agent agentNum ]

  foreach playerPosition [ agentNum ->
    file-print (word "CONFIRM|" currentRound "|" currentPhase "|" agentNum "|" date-and-time)
    confirm-actions agentNum
  ]

  if (currentRound = roundBefore) and (currentPhase = phaseBefore) and (gameInProgress = 1) [
    ;; safety valve -- nothing advanced this pass. Stop rather than loop forever.
    output-print "go: round/phase did not advance this pass -- stopping to avoid a stall."
    stop
  ]

  tick

end
]]></code>
  <widgets>
    <input x="10" multiline="false" y="10" height="60" variable="sessionParameters" type="string" width="320" sizeVersion="0">sessionList_ABM.csv</input>
    <button x="10" y="80" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="1. Read Session File" width="320" sizeVersion="0">prepare-session</button>
    <input x="10" multiline="false" y="123" height="60" variable="sessionID" type="number" width="320" sizeVersion="0">2.0</input>
    <slider x="10" y="193" width="320" height="34" min="4" max="30" default="8.0" step="1" direction="Horizontal" display="patches_game" variable="patches_game"></slider>
    <slider x="10" y="237" width="320" height="34" min="1" max="21" default="3.0" step="1" direction="Horizontal" display="numAgents" variable="numAgents"></slider>
    <button x="10" y="281" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="2. Initialize Session" width="320" sizeVersion="0">initialize-session</button>
    <button x="10" y="324" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="3. Setup" width="320" sizeVersion="0">setup</button>
    <monitor x="10" y="367" height="45" precision="0" fontSize="11" width="320" display="current tick (round/phase step)">ticks</monitor>
    <button x="10" y="418" height="33" disableUntilTicks="true" forever="true" kind="Observer" display="4. Go / Pause" width="320" sizeVersion="0">go</button>
    <output x="10" y="461" height="300" fontSize="12" width="320"></output>
    <plot x="340" y="10" width="320" height="220" xMin="0.0" xMax="10.0" yMin="0.0" yMax="10.0" autoPlotX="true" autoPlotY="true" legend="true" display="Player Score">
      <setup></setup>
      <update></update>
      <pen display="current score" interval="1.0" mode="0" color="-16776961" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen display="total score" interval="1.0" mode="0" color="-16738816" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="340" y="240" width="320" height="220" xMin="0.0" xMax="10.0" yMin="0.0" yMax="10.0" autoPlotX="true" autoPlotY="true" legend="true" display="Player Resources">
      <setup></setup>
      <update></update>
      <pen display="avg resources" interval="1.0" mode="0" color="-29696" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="340" y="470" width="320" height="220" xMin="0.0" xMax="10.0" yMin="0.0" yMax="10.0" autoPlotX="true" autoPlotY="true" legend="true" display="Actions Taken">
      <setup></setup>
      <update></update>
      <pen display="actions this phase" interval="1.0" mode="0" color="-2354156" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="340" y="700" width="320" height="220" xMin="0.0" xMax="10.0" yMin="0.0" yMax="10.0" autoPlotX="true" autoPlotY="true" legend="true" display="Custom Outcomes">
      <setup></setup>
      <update></update>
    </plot>
    <view x="680" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="600" showTickCounter="false" patchSize="75.0" fontSize="13" wrappingAllowedY="false" width="600" tickCounterLabel="ticks" maxPycor="7" updateMode="0" maxPxcor="7" minPxcor="0"></view>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

Standalone ABM interpreter for tapSquares-style games. Runs autonomous,
behavior-weight-driven agents through a game -- no HubNet clients, no
control panel, no human input. Reuses game_details.nls (unchanged) for
everything game-specific; swap that file to point this interpreter at a
different tapSquares game.

## HOW TO RUN A SESSION

1. Point "sessionParameters" at your session CSV (defaults to
   sessionList_ABM.csv) and set "sessionID" to match a row in it.
2. Press "1. Read Session File".
3. Press "2. Initialize Session".
4. Press "3. Setup" -- edit the number on the button for how many agents.
5. Press "4. Go".

See the comment block at the top of the Code tab for the full design
notes, known limitations, and which globals are worth exposing as
interface sliders.
]]></info>
