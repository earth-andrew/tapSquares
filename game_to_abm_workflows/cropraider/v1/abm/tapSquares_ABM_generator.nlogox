<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[extensions [csv palette table]

__includes ["game details.nls"]

;; ============================================================================
;; tapSquares ABM interpreter -- standalone. Runs autonomous, behavior-
;; weight-driven agents through a tapSquares-style game with no HubNet
;; clients and no human input. Reuses game details.nls unchanged -- swap in
;; a different game's own game_details.nls (same filename) to point this
;; interpreter at a different game; nothing below needs to change.
;;
;; This is a from-scratch rebuild, not the human-play tapSquares template
;; with things bolted on -- there is no HubNet code, no control panel, no
;; confirm button, and no information-screen handling here at all (agents
;; act on state directly; they don't need to be shown a summary the way a
;; human player does). Every procedure below is either reused verbatim from
;; tapSquares (the generic, CSV-driven engine: file readers, spatial/non-
;; spatial function runners, patch-choice/appearance updates) or new here
;; (the decision policy and the autonomous round loop).
;;
;; Village/private land phases. chooseVillageLand?/choosePrivateLand? are
;; read from sessionList (same as a human game); when either is true, setup
;; calls randomly-assign-villages and/or randomly-assign-private-land to
;; make an autonomous equivalent of the human clicking-flow -- villages are
;; a random contiguous flood-fill partition of the whole board (same
;; algorithm game details.nls's randomly-assign-landscape uses for
;; individual ownership, one level up), and each player then claims up to
;; maxPrivateSquares patches at random (scoped to their own village, if
;; chooseVillageLand? is also true).
;;
;; KNOWN LIMITATION -- tap-count features. If your R model used
;; n_taps_patch or n_taps_turn as predictors (how many times a human
;; retapped a patch, or tapped anywhere that turn), those have no
;; autonomous-agent equivalent -- an algorithm doesn't hesitate the way a
;; person does. get-feature-value treats their contribution as zero, with a
;; one-time console note the first time it happens.
;;
;; HOW TO RUN A SESSION (buttons are already wired up on the interface):
;;   1. sessionParameters / sessionID inputs default to sessionList_ABM.csv
;;      / 2 -- change them if you add more rows.
;;   2. press "Read Session File" (prepare-session).
;;   3. press "Initialize Session" (initialize-session).
;;   4. set the "world size" and "number of agents" sliders if you don't
;;      want the defaults (8x8 board, 3 agents).
;;   5. press "Setup" (setup).
;;   6. press "Go" (go).
;;
;; patches_game (world side length) and numAgents (agent count) are both
;; interface sliders, not values buried in code or a button -- drag them
;; before pressing Setup. patches_game is fully free to change, since this
;; world has no control panel to lay out around it (see setup). numAgents
;; is capped at colorList's length (21 by default, in prepare-session) --
;; add more colors there if you need more agents than that.
;; Everything else model-specific (endowment, fractionWater, growth rates,
;; elephant behavior parameters, ...) comes from sessionList_ABM.csv.
;; ============================================================================


;; ============================================================================
;; BREEDS
;; ============================================================================

breed [borders border]
breed [actions action]
breed [ICs IC]
breed [landStates landState]
breed [visuals visual]
breed [spatialFunctions spatialFunction]
breed [nonSpatialFunctions nonSpatialFunction]
breed [scoringFunctions scoringFunction]
breed [landDisplays landDisplay]
breed [displayTurtles displayTurtle]
breed [ownerBoxes ownerBox]
;; behaviors holds one row per line of agent_behavior_weights.csv, following
;; the same "one row -> one hidden data-holding turtle" pattern as actions/
;; ICs/etc. below
breed [behaviors behaviorRow]
;; outcomePlots holds one row per line of an OPTIONAL outcomePlotList.csv --
;; same data-holder pattern again. Lets a game wire its own outcome
;; variables (e.g. harvestYield, elephantCount) into the generic "Custom
;; Outcomes" plot without touching this file -- see read-outcome-plot-file.
breed [outcomePlots outcomePlot]

patches-own [inGame? selected? shared? village ownedBy playerAccess selectedBy landChoices currentChoice currentEffort]
borders-own [identity]
visuals-own [identity visibleTo]
actions-own [actionID imageName round_play phaseAvailable effort flags]
landStates-own [stateID flags imageName stateColor]
ICs-own [conditionID variable conditionType probability onlyIf notIf valueMode valueExpression minValue maxValue]
spatialFunctions-own [functionID trigger localVariables localTargets expression phase round_play xOffset yOffset]
nonSpatialFunctions-own [functionID expression phase round_play]
scoringFunctions-own [scoreID property value trigger localTarget playerTarget operation show? imageName column round_play phase playerMarker loop? patchLevel?]
landDisplays-own [turtleID countMeasure imageName mobile? transparent? turtleSizeMin turtleSizeMax]
displayTurtles-own [identity secondIdentity mobile? owner fed? transparent?]
behaviors-own [agent_type decision_stage outcome_option feature weight]
outcomePlots-own [plotID plotLabel reporter penColor]   ;; "plotLabel" not "label" -- label is a built-in turtle variable


;; ============================================================================
;; GLOBALS
;; ============================================================================

globals [
  ;; roster / game mechanism
  numPlayers
  playerNames
  playerPosition
  playerConfirm
  playerCurrentScore
  playerCurrentResources
  playerTotalScore
  gameInProgress
  ;; patches_game and numAgents are NOT declared here -- both are interface
  ;; sliders (see widgets), and NetLogo creates their global automatically
  ;; from the slider. Declaring a slider's variable again in globals[]
  ;; risks the slider's on-load default never actually reaching the
  ;; code-side variable (confirmed by a real runtime error: patches_game
  ;; reads 0 at setup time -- "You must include the point (0, 0) in the
  ;; world" -- even after ruling out clear-all as the cause). Both are
  ;; still ordinary globals from every procedure's point of view; they're
  ;; just not redeclared here.
  ;; numRounds/numPhases stay declared here (NOT sliders -- read from
  ;; sessionList.csv/sessionList_ABM.csv by set-game-parameters, which
  ;; generically does `run "set numRounds <value>"` for every session
  ;; column; removing the global would crash that). Both are real,
  ;; structural state, on purpose: every round_play/phase column in a
  ;; game's actionList.csv/spatialFunctionList.csv/nonSpatialFunctionList.csv
  ;; is authored assuming specific numRounds/numPhases values (e.g.
  ;; Crouching Tiger's "phase 2" only means anything because numPhases=2
  ;; combined with chooseVillageLand?+choosePrivateLand?), so neither can
  ;; ever safely become an interface slider -- changing either without
  ;; rewriting the game's own content would desynchronize the two. The ABM
  ;; runs for exactly as many rounds/phases as the game itself was
  ;; authored for, same as a human playthrough -- if you want a longer or
  ;; shorter run, change numRounds in sessionList.csv, not a slider. The
  ;; general rule: a parameter only belongs on the interface if no
  ;; game-content file is authored assuming a fixed value for it.
  numRounds
  numPhases
  currentRound
  currentPhase
  maxPrivateSquares          ;; sessionList.csv column -- cap on how many patches each player claims in randomly-assign-private-land
  villageMembership          ;; sessionList.csv column -- maps player (1-indexed) to village number, same convention as the human template
  villageMemberList          ;; list, one entry per village number: which players (1-indexed) belong to it -- built by finish-village-assignment
  villageAssignmentSource    ;; OPTIONAL sessionList.csv column -- path to a real played session's output .csv; if given, villageCoverageTarget is estimated from it (see estimate-village-coverage-from-log) rather than read as a literal number
  villageCoverageTarget      ;; fraction (0-1) of the board villages should end up claiming; the rest stays open/unclaimed. A scalable PROPERTY (not a literal layout), so it transfers to any board size. Defaults to 1 (whole board claimed, the old behavior) if never set by either sessionList.csv column above.
  actionEffortList
  endowment
  tempValue

  ;; visualization (only what's still drawn: grid lines and patch tint)
  colorList
  border_color
  village_border_color
  playerColor
  selected_shading
  patch_color_min
  patch_color_max
  patch_color_property

  ;; session-parameter parsing (generic CSV-driven, same as tapSquares)
  inputFileLabels
  completedGamesIDs
  parsedInput
  currentSessionParameters
  gameID
  gameName
  sessionList
  chooseVillageLand?
  choosePrivateLand?
  parameterHandled
  actionListFileName
  actionInputs
  actionPropertyLabels
  initialConditionListFileName
  icInputs
  icPropertyLabels
  turtleListFileName
  turtleInputs
  turtlePropertyLabels
  stateListFileName
  stateInputs
  statePropertyLabels
  spatialFunctionListFileName
  sfInputs
  sfPropertyLabels
  nonSpatialFunctionListFileName
  nsfInputs
  nsfPropertyLabels
  scoringFunctionFileName
  scoringInputs
  scoringPropertyLabels
  infoScreenListFileName     ;; real sessionList.csv column -- kept for load-safety; info screens themselves are never shown (see note above)
  patchPropertyList

  ;; ABM-specific
  behaviorListFileName
  referenceActionFileName
  behaviorInputs
  behaviorPropertyLabels
  referenceActionID          ;; actionID whose fitted score is defined as 0 (the baseline every other action's log-odds is relative to)
  agentClassList              ;; list, one entry per agent (index 0 = agent 1, ...) e.g. ["class_1" "class_2" "class_1"]
  currentABMAgent             ;; which agent's decision is currently being scored -- read by get-feature-value when resolving player-level features
  warnedNoTapAnalog            ;; true once we've printed the n_taps_patch/n_taps_turn note, so we don't spam it
  warnedUnresolvedFeatures    ;; list of feature names we've already printed a "couldn't resolve" note for, so we don't spam it
  featureResolutionCache      ;; table: featureName -> (list recipeType candidateName levelSuffix), see classify-feature-name. Avoids re-probing every scoring call.

  ;; plotting
  outcomePlotListFileName    ;; OPTIONAL sessionList.csv column -- game-specific outcome series for the "Custom Outcomes" plot. Blank/missing/not-found is fine; that plot just stays empty.
  outcomePlotInputs
  outcomePlotPropertyLabels
  outcomePlotsLoaded?
  plotStep                   ;; one tick per completed phase -- x-axis for every plot, since currentRound/currentPhase together aren't a single increasing number
]


;; ============================================================================
;; SESSION LOADING -- reused from tapSquares (generic, CSV-driven, no HubNet)
;; ============================================================================

to prepare-session
  ;; equivalent to tapSquares' start-hubnet, minus hubnet-reset and every
  ;; panel-specific default (patches_panel, confirm button colors, panel
  ;; row/scoring layout, HubNet client shape defaults for breeds that no
  ;; longer exist here)

  ;; NOT clear-all -- clear-all includes clear-globals, which resets every
  ;; global (including patches_game/numAgents, the two slider-bound ones)
  ;; to 0 and leaves them there; the sliders don't automatically re-push
  ;; their on-screen value afterward. That 0 would otherwise survive all
  ;; the way to setup's resize-world call and fail with "You must include
  ;; the point (0, 0) in the world." (confirmed by a real runtime error).
  ;; Everything else clear-all would have done is listed explicitly below.
  clear-ticks
  clear-patches
  clear-turtles
  clear-drawing
  clear-all-plots
  clear-output

  set playerNames (list)
  set playerPosition (list)
  set playerColor (list)
  set numPlayers 0
  set gameInProgress 0

  set-default-shape borders "line"
  set-default-shape actions "blank"
  set-default-shape ICs "blank"
  set-default-shape landStates "blank"
  set-default-shape spatialFunctions "blank"
  set-default-shape scoringFunctions "blank"
  set-default-shape landDisplays "blank"
  set-default-shape nonSpatialFunctions "blank"
  set-default-shape ownerBoxes "empty-square"

  ;; patches_game is NOT set here -- it's a slider on the interface (see
  ;; widgets), so its current on-screen value is what's already live the
  ;; moment this runs. Setting it here would silently overwrite whatever
  ;; the user dragged it to every time "Read Session File" is pressed.
  set border_color 0
  set village_border_color 2
  set villageCoverageTarget 1   ;; default: whole board claimed (old behavior); sessionList.csv (a literal number) or villageAssignmentSource (estimated from a real log, in setup) can override this
  set colorList (list 95 15 25 115 125 5 135 93 13 23 113 123 3 133 98 18 28 118 128 8 138)  ;; add to this if you will have more than 21 agents, but really, you shouldn't!!!
  set selected_shading 0.8

  ;; try to read in the input parameter data -- stop if the file doesn't exist
  if not file-exists? sessionParameters [
    user-message "Please enter a valid file name for session data"
    stop
  ]

  let delimiter detect-delimiter sessionParameters
  set parsedInput (csv:from-file sessionParameters delimiter)
  set inputFileLabels item 0 parsedInput
  set sessionList []
  foreach but-first parsedInput [ ?1 -> set sessionList lput (item 0 ?1) sessionList ]
  set sessionList remove-duplicates sessionList

  ;; look in the list of completed game IDs, and take an initial guess that
  ;; the session of interest is one higher than the highest session completed previously
  set completedGamesIDs []
  ifelse file-exists? "completedGames.csv" [
    file-open "completedGames.csv"
    while [not file-at-end?] [
      set tempValue file-read-line
      set completedGamesIDs lput read-from-string substring tempValue 0 position "_" tempValue completedGamesIDs
    ]
    set completedGamesIDs remove-duplicates completedGamesIDs
    set sessionID max completedGamesIDs + 1
    file-close
  ] [
    set sessionID -9999
  ]

  set currentSessionParameters []

end


to initialize-session
  ;; unchanged from tapSquares -- picks the current session's parameter row
  ;; out of the already-parsed sessionList.csv

  if (length currentSessionParameters > 0) [
    user-message "Current session is not complete. Please continue current session. Otherwise, to start a new session, first clear settings by running \"Read Session File\" again."
    stop
  ]

  if (not member? sessionID sessionList) [
    user-message "Session ID not found in input records"
    stop
  ]

  if (member? sessionID completedGamesIDs) [
    user-message "Warning: At least one game file with this sessionID has been found"
  ]

  set currentSessionParameters filter [ ?1 -> item 0 ?1 = sessionID ] parsedInput

end


to set-game-parameters
  ;; unchanged from tapSquares -- applies one row of session parameters to
  ;; globals, generically, via the variable-name/value pairing in the CSV

  let currentGameParameters item 0 currentSessionParameters
  set currentSessionParameters sublist currentSessionParameters 1 length currentSessionParameters

  (foreach inputFileLabels currentGameParameters [ [?1 ?2] ->

    set parameterHandled 0

    if parameterHandled = 0 and (?1 = "villageMembership" or ?1 = "patch_color_min" or ?1 = "patch_color_max") [
      file-print (word ?1 ": " ?2 )
      let currentParameter []
      set currentParameter (word "set " ?1 " (list " ?2 ")" )
      run currentParameter
      set parameterHandled 1
    ]

    if parameterHandled = 0 [
      file-print (word ?1 ": " ?2 )
      let currentParameter []
      ifelse is-string? ?2 [
        set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
      ][
        set currentParameter (word "set " ?1 " " ?2 )
      ]
      run currentParameter
      set parameterHandled 1
    ]

  ])
  file-print ""

end


;; ============================================================================
;; CSV READERS -- reused from tapSquares, unchanged except for one thing:
;; every "string value" branch below now does
;;   set tempValue remove "\\" ?2
;; instead of assigning ?2 straight through. NetLogo's own csv extension
;; escapes an embedded quote inside a quoted field as \" (backslash-quote),
;; not the more common "" (doubled-quote) convention -- so a field like
;; [shape = "grass"] is written in the CSV as ...\""grass\""... and comes
;; back from csv:from-file as ...\"grass\"... (the doubled quotes collapse
;; to one real quote, but the backslash marking the escape is left behind
;; as a literal character). That's invisible as long as the value is only
;; ever stored, but the moment it's handed to run/runresult as actual code
;; (e.g. run-spatial-functions running a stored "expression"), NetLogo's
;; run-time parser rejects any backslash outright ("This non-standard
;; character is not allowed") -- confirmed by a real runtime error. remove
;; "\\" strips that leftover backslash, leaving the real quotes intact.
;;
;; Each reader follows the same pattern otherwise: read the file, take the
;; header row as property labels, create one hidden data-holding turtle per
;; remaining row, and generically apply every column's value to that
;; turtle's own-variable of the same name.
;; ============================================================================

to read-action-file

  if not file-exists? actionListFileName [
    user-message "Please enter valid file name for action data"
    stop
  ]

  let delimiter detect-delimiter actionListFileName
  set actionInputs (csv:from-file actionListFileName delimiter)
  set actionPropertyLabels item 0 actionInputs
  foreach but-first actionInputs [ ?0 ->

    let currentAction ?0

    create-actions 1 [
      (foreach actionPropertyLabels currentAction [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 and (?1 = "phaseAvailable" or ?1 = "round_play" or ?1 = "changesAllowed" or ?1 = "flags") [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          set currentParameter (word "set " ?1 " (list " ?2 ")" )
          run currentParameter
          set parameterHandled 1
        ]

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  set actionEffortList n-values (count actions) [0]
  foreach n-values (count actions) [ ?1 -> ?1 + 1] [ ?1 ->
    ask one-of actions with [actionID = ?1] [
      set actionEffortList replace-item (?1 - 1) actionEffortList effort
    ]
  ]

  output-print "action file read."

end


to read-state-file

  if not file-exists? stateListFileName [
    user-message "Please enter valid file name for state data"
    stop
  ]

  let delimiter detect-delimiter stateListFileName
  set stateInputs (csv:from-file stateListFileName delimiter)
  set statePropertyLabels item 0 stateInputs
  foreach but-first stateInputs [ ?0 ->

    let currentLandState ?0

    create-landStates 1 [
      (foreach statePropertyLabels currentLandState [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 and (?1 = "phaseAvailable" or ?1 = "changesAllowed" or ?1 = "flags") [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          set currentParameter (word "set " ?1 " (list " ?2 ")" )
          run currentParameter
          set parameterHandled 1
        ]

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  output-print "state file read."

end


to read-turtle-file

  if not file-exists? turtleListFileName [
    user-message "Please enter valid file name for turtle data"
    stop
  ]

  let delimiter detect-delimiter turtleListFileName
  set turtleInputs (csv:from-file turtleListFileName delimiter)
  set turtlePropertyLabels item 0 turtleInputs
  foreach but-first turtleInputs [ ?0 ->

    let currentTurtles ?0

    create-landDisplays 1 [
      (foreach turtlePropertyLabels currentTurtles [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  output-print "turtle file read."

end


to read-spatial-function-file

  if not file-exists? spatialFunctionListFileName [
    user-message "Please enter valid file name for spatial function data"
    stop
  ]

  let delimiter detect-delimiter spatialFunctionListFileName
  set sfInputs (csv:from-file spatialFunctionListFileName delimiter)
  set sfPropertyLabels item 0 sfInputs
  foreach but-first sfInputs [ ?0 ->

    let currentFunction ?0

    create-spatialFunctions 1 [
      (foreach sfPropertyLabels currentFunction [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 and (?1 = "localVariables" or ?1 = "localTargets" or ?1 = "phase" or ?1 = "round_play") [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          set currentParameter (word "set " ?1 " (list " ?2 ")" )
          run currentParameter
          set parameterHandled 1
        ]

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  output-print "spatial function file read."

end


to read-non-spatial-function-file

  if not file-exists? nonSpatialFunctionListFileName [
    user-message "Please enter valid file name for nonspatial function data"
    stop
  ]

  let delimiter detect-delimiter nonSpatialFunctionListFileName
  set nsfInputs (csv:from-file nonSpatialFunctionListFileName delimiter)
  set nsfPropertyLabels item 0 nsfInputs
  foreach but-first nsfInputs [ ?0 ->

    let currentFunction ?0

    create-nonSpatialFunctions 1 [
      (foreach nsfPropertyLabels currentFunction [ [?1 ?2] ->

        set parameterHandled 0

        if parameterHandled = 0 and (?1 = "localVariables" or ?1 = "localTargets" or ?1 = "phase" or ?1 = "round_play") [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          set currentParameter (word "set " ?1 " (list " ?2 ")" )
          run currentParameter
          set parameterHandled 1
        ]

        if parameterHandled = 0 [
          file-print (word ?1 ": " ?2 )
          let currentParameter []
          ifelse is-string? ?2 [
            set tempValue remove "\\" ?2
        set currentParameter (word "set " ?1 " tempValue")
          ][
            set currentParameter (word "set " ?1 " " ?2 )
          ]
          run currentParameter
          set parameterHandled 1
        ]

      ])
    ]
  ]

  output-print "non-spatial function file read."

end


to read-scoring-function-file

  if not file-exists? scoringFunctionFileName [
    user-message "Please enter valid file name for scoring function"
