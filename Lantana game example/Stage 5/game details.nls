globals [
  pDegraded_increment
]

patches-own [
  hasResource
  degraded
  pDegraded
  totalHarvestedLight
  totalHarvestedHeavy
]

to set-initial-player-conditions

end

to set-initial-patch-conditions
  set hasResource false
  set degraded false
  set pDegraded 0
  set totalHarvestedLight 0
  set totalHarvestedHeavy 0
end

to set-additional-game-level-conditions

end
