;; game details.nls
;; Tiger game — Stage 7 of 10
;; See the tapSquares Builder Guide for the goals, key concepts, and testing
;; goals associated with this stage.

globals [
  grassR
  grassK
  numAnimals
  minGrassMass
  grassPerTurnEat
  pDie_unfed
  grassMass_forage
  pAttack_increment
]

patches-own [
  treeCount
  grassMass
  animalCount
  forageCount
  forageMass
  fenced?
  pAttack
  attacked?
  animalLoss
]

to set-initial-player-conditions
end

to set-initial-patch-conditions
  set animalCount n-values numPlayers [0]
  set forageCount 0
  set forageMass 0
  set fenced? false
  set attacked? false
end

to set-additional-game-level-conditions

end

;; Note: the original file also declared a "forested" boolean patch property,
;; initialized false and never set true anywhere, which meant the five
;; forest-driven predation rows in spatialFunctionList.csv could never fire.
;; That variable has been removed throughout this build; forest cover is
;; read directly off treeCount (treeCount > 0) wherever it's needed instead
;; — see Stage 7.
