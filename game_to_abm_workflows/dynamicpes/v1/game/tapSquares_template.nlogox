<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[extensions [bitmap csv palette]

__includes ["game details.nls"]

;;Game builders may opt for game-specific breeds
breed [borders border]
breed [counters counter]
breed [buttons button]
breed [actions action]
breed [ICs IC]
breed [scorecards scorecard]
breed [landStates landState]
breed [visuals visual]
breed [spatialFunctions spatialFunction]
breed [nonSpatialFunctions nonSpatialFunction]
breed [scoringFunctions scoringFunction]
breed [infoScreenFunctions infoScreenFunction]
breed [panelEdges panelEdge]
breed [landDisplays landDisplay]
breed [displayTurtles displayTurtle]
breed [integer-agents integer-agent]
breed [ownerBoxes ownerBox]

;;Game builders may opt for game-specific turtle and patch properties
patches-own [inGame? selected? shared? village ownedBy playerAccess selectedBy landChoices currentChoice currentEffort]
counters-own [identity]
borders-own [identity]
visuals-own [identity visibleTo]
buttons-own [identity]
integer-agents-own [ID visibleTo summaryOf]
actions-own [actionID imageName round_play phaseAvailable effort flags]
landStates-own [stateID flags imageName stateColor]
ICs-own [conditionID variable conditionType probability onlyIf notIf valueMode valueExpression minValue maxValue]
scorecards-own [identity]
spatialFunctions-own [functionID trigger localVariables localTargets expression phase round_play xOffset yOffset]
nonSpatialFunctions-own [functionID expression phase round_play]
scoringFunctions-own [scoreID property value trigger localTarget playerTarget operation show? imageName column round_play phase playerMarker loop? patchLevel?]
infoScreenFunctions-own [screenID level parameter round_play phase]
landDisplays-own [turtleID countMeasure imageName mobile? transparent? turtleSizeMin turtleSizeMax]
displayTurtles-own [identity secondIdentity mobile? owner fed? transparent?]

globals [
  ;;game mechanism values
  numPlayers
  playerNames
  playerPosition
  playerConfirm
  playerCounts
  playerCurrentScore
  playerCurrentResources
  playerTotalScore
  messageAddressed
  gameInProgress
  langSuffix
  patches_game
  patches_panel
  panel_scoring_min
  panel_scoring_max
  panel_row_max_size
  panel_row_size
  numRounds
  numPhases
  choosingPrivateLand
  choosingVillageLand
  currentRound
  currentPhase
  maxPrivateSquares
  villageMembership
  villageMemberList
  actionEffortList
  endowment
  tempScoring
  tempValue


  



  ;;visualization parameters and variables
  colorList
  border_color
  village_border_color
  playerColor
  number_shape_list
  confirm_area
  confirm-up-color
  confirm-down-color
  access_shading
  selected_shading
  in_game_color
  currentInformationScreen
  patch_color_min
  patch_color_max
  patch_color_property
  rgb_R
  rgb_G
  rgb_B




  ;;variables related to parsing parameter input
  inputFileLabels
  completedGamesIDs
  parsedInput
  currentSessionParameters
  gameID
  gameName
  sessionList
  chooseVillageLand?
  choosePrivateLand?
  parameterHandled
  actionListFileName
  actionInputs
  actionPropertyLabels
  initialConditionListFileName
  icInputs
  icPropertyLabels
  turtleListFileName
  turtleInputs
  turtlePropertyLabels
  stateListFileName
  stateInputs
  statePropertyLabels
  spatialFunctionListFileName
  sfInputs
  sfPropertyLabels
  nonSpatialFunctionListFileName
  nsfInputs
  nsfPropertyLabels
  scoringFunctionFileName
  scoringInputs
  scoringPropertyLabels
  infoScreenListFileName
  ifInputs
  ifPropertyLabels
  
  ;;file parameters
  patchPropertyList
  ]




;;EXAMPLES OF PROCEDURES THAT GAMES **WILL DEFINITELY** USE

to start-hubnet
  ;; do everything here that needs to be done before all games, and will be preserved for all games

  ;; clean the slate
  clear-all

  ;; clear anything from the display, just in case
  clear-ticks
  clear-patches
  clear-turtles
  clear-drawing

  ;; reset the hubnet
  hubnet-reset

  ;; set all session variables that are preserved across games
  set playerNames (list)
  set playerPosition (list)
  set playerColor (list)
  set numPlayers 0
  set gameInProgress 0
  set-default-shape borders "line"
  set-default-shape counters "blank"
  set-default-shape actions "blank"
  set-default-shape ICs "blank"
  set-default-shape scorecards "blank"
  set-default-shape landStates "blank"
  set-default-shape spatialFunctions "blank"
  set-default-shape scoringFunctions "blank"
  set-default-shape infoScreenFunctions "blank"
  set-default-shape landDisplays "blank"
  set-default-shape nonSpatialFunctions "blank"
  set-default-shape panelEdges "bar"
  set-default-shape ownerBoxes "empty-square"

  set patches_game 8

  set border_color 0
  set village_border_color 2
  set colorList (list 95 15 25 115 125 5 135 93 13 23 113 123 3 133 98 18 28 118 128 8 138)  ;; add to this if you will have more than 21 players, but really, you shouldn't!!!
  set number_shape_list (list "num-0" "num-1" "num-2" "num-3" "num-4" "num-5" "num-6" "num-7" "num-8" "num-9")
  set confirm-up-color lime
  set confirm-down-color 61
  set access_shading 0.8; (- 3)
  set selected_shading 0.8; (- 3)
  set in_game_color 54
  set currentInformationScreen 0


  set rgb_G 100
  set rgb_B 0
  set rgb_R 150


  ;; try to read in the input parameter data - stop if the file doesn't exist
  if not file-exists? sessionParameters [ ;;if game parameter file is incorrect
    user-message "Please enter valid file name for input data"
    stop
  ]

  ;; open the file and read it in line by line
  let delimiter detect-delimiter sessionParameters
  set parsedInput (csv:from-file sessionParameters delimiter)
  set inputFileLabels item 0 parsedInput
  set sessionList []
  foreach but-first parsedInput [ ?1 -> set sessionList lput (item 0 ?1) sessionList ]
  set sessionList remove-duplicates sessionList

  ;; look in the list of completed game IDs, and take an initial guess that the session of interest is one higher than the highest session completed previously
  set completedGamesIDs []
  ifelse file-exists? "completedGames.csv" [
  file-open "completedGames.csv"
  while [not file-at-end?] [
    set tempValue file-read-line
    set completedGamesIDs lput read-from-string substring tempValue 0 position "_" tempValue completedGamesIDs
  ]
  set completedGamesIDs remove-duplicates completedGamesIDs
  set sessionID max completedGamesIDs + 1
  file-close
  ] [
  set sessionID -9999
  ]



  set currentSessionParameters []


end

to update-all-resources [playerNumber]

  let currentSpending sum [currentEffort] of patches with [inGame? and selectedBy = (playerNumber + 1)]
  let currentBudget endowment - currentSpending
  set playerCurrentResources replace-item playerNumber playerCurrentResources currentBudget
  ask integer-agents with [ID = "currentResource" and member? playerNumber visibleTo] [die]
  integer-as-agents (item (playerNumber ) playerCurrentResources) 1 red (- patches_panel * 0.5) (patches_game * 0.715) (list playerNumber) "currentResource"
  ask integer-agents with [ID = "resource" and member? playerNumber visibleTo] [die]
  integer-as-agents (item (playerNumber ) playerTotalScore) 1 green (- patches_panel * 0.5) (patches_game * 0.025) (list playerNumber) "scoring"

end

to initialize-session

  ;; stop if we are currently in a session
  if (length currentSessionParameters > 0)
  [user-message "Current session is not complete.  Please continue current session.  Otherwise, to start new session, please first clear settings by clicking 'Launch Broadcast'"
    stop]

  ;; if the session requested isn't in our input parameters, stop
  if (not member? sessionID sessionList)
  [user-message "Session ID not found in input records"
    stop]

  ;; if the session requested has prior game data available, let the user know
  if (member? sessionID completedGamesIDs)
  [user-message "Warning: At least one game file with this sessionID has been found"]

  ;; pick the appropriate set of parameters for the current session from the previously parsed input file (i.e., all games listed as part of session 1)
  set currentSessionParameters filter [ ?1 -> item 0 ?1 = sessionID ] parsedInput

end

to start-game

  ;; stop if a game is already running
  if (gameInProgress = 1)
  [user-message "Current game is not complete.  Please continue current game.  Otherwise, to start new session, please first clear settings by clicking 'Launch Broadcast'"
    stop]

  ;; stop if there are no more game parameters queued up
  if (length currentSessionParameters = 0)
  [user-message "No games left in session.  Re-initialize or choose new session ID"
    stop]

  ;; stop if there are no players
  if (length playerNames = 0)
  [user-message "No players are joined.  Ensure 'Listen clients' is enabled, and clients have joined"
    stop]

  ;; clear the output window and display
  clear-output
  clear-patches
  clear-turtles
  clear-drawing
  foreach playerPosition [ ?1 ->
    hubnet-clear-overrides (item (?1 - 1) playerNames)
  ]
  output-print "Output/Display cleared."

  ;;Set any parameters not set earlier, and not to be set from the read-in game file
  set playerCounts n-values numPlayers [0]
  set playerConfirm n-values numPlayers [0]
  set playerCurrentScore n-values numPlayers [0]
  set playerCurrentResources n-values numPlayers [endowment]
  set playerTotalScore n-values numPlayers [0]

  ;;GAME SPECIFIC PLAYER LEVEL VARIABLES

  set-initial-player-conditions

  ;set-default-shape borders "line"
  output-print "Game parameters initialized."

  ;; Start the game output file
  ;; the code below builds the game output file, named by the players and the current timestamp
  let tempDate date-and-time
  foreach [2 5 8 12 15 18 22] [ ?1 -> set tempDate replace-item ?1 tempDate "_" ]
  let playerNameList (word (item 0 playerNames) "_")
  foreach n-values (numPlayers - 1) [ ?1 ->  ?1 + 1 ] [ ?1 ->
   set playerNameList (word playerNameList "_" (item ?1 playerNames))
  ]
  set gameName (word gameID "_" playerNameList "_" tempDate ".csv" )
  carefully [file-delete gameName file-open gameName] [file-open gameName]
  output-print "Game output file created."

  ;; read in game file input
  set-game-parameters

  ;; read in actions list
  read-action-file

  ;; read in state list
  read-state-file

  ;; read in turtles for display list
  read-turtle-file

  ;; read in spatial function file
  read-spatial-function-file

  ;; read in non-spatial function file
  read-non-spatial-function-file

  ;; read in scoring function
  read-scoring-function-file

  ;; read in screen file
  read-info-screen-file


  ;; read in initial conditions
  read-initial-condition-file

  ;;lay out the game board
  set patches_panel 4
  resize-world (- patches_panel) (patches_game - 1) 0 (patches_game - 1)
  set panel_scoring_min 2
  set panel_scoring_max 5
  set panel_row_max_size 1
  let numShows 0
  let numCols 0
  if count scoringFunctions > 0 [
    set numShows count scoringFunctions with [show?]
    set numCols (max [column] of scoringFunctions) + 1
  ]
  set panel_row_size (min (list panel_row_max_size ((panel_scoring_max - panel_scoring_min) / (max list 1 numShows)) ((patches_panel - 1) / (max list 1 numCols))))

  ;;make the confirm button
  set confirm_area (list (- 2.5) (patches_game - 1.7) 1.8 0.9)
    create-buttons 1 [setxy (item 0 confirm_area + (item 2 confirm_area / 2)) (item 1 confirm_area + (item 3 confirm_area / 2)) set size item 2 confirm_area set color confirm-up-color set identity "confirm" set shape "confirm"]

  ;; separate the game land from the display area, and seed the landscape
  ask patches [

    set selected? false
    if-else (pxcor < 0) [
      set inGame? false
      set pcolor 0



    ][
      set inGame? true
      set pcolor update-patch-color
      set playerAccess n-values numPlayers [i -> i + 1]
      set currentChoice -99
      set ownedBy -99
      sprout-ownerBoxes 1 [set color red set hidden? true]

      ;;GAME SPECIFIC CONDITIONS THAT SHOULD BE SET

      set-initial-patch-conditions


    ]
  ]

  ;;show divisions between patches
  make-borders

  ;;mark the panel border
  make-panel-border

  ;;initialize all conditions to false
  ask patches with [inGame?] [


  ]


  if  chooseVillageLand? [
    ;Make lists of which players are in each village
    let shortVillageMembership sublist villageMembership 0 (numPlayers)
    let numVillages max shortVillageMembership
    set villageMemberList n-values numVillages [[]]

    let all-indices range length shortVillageMembership
    foreach n-values max shortVillageMembership [i -> i + 1] [i ->

      ; Filter these indices, keeping only those where the item at that index matches the target-value
      set villageMemberList (replace-item (i - 1) villageMemberList map [? -> ? + 1] (filter [j -> item j shortVillageMembership = i] all-indices))


    ]

    ;;make little village indicators for each player
    ask patch min-pxcor min-pycor [sprout 5 [set size 0.3 setxy (min-pxcor - 0.25 + random-float 0.5) (min-pycor - 0.25 + random-float 0.5) set shape "house" set color brown]]
    foreach playerPosition [ ?1 ->
      integer-as-agents (item (?1 - 1 ) villageMembership) 0.5 white min-pxcor min-pycor (list (?1 - 1)) "villageID"

    ]
  ]


  set-additional-game-level-conditions

  set-initial-conditions
  
  ask patches with [inGame?] [update-patch-image set pcolor update-patch-color]

  ;;make a round counter visible to all
  set currentRound 0
  set currentPhase 1
  
  (if-else

    chooseVillageLand? [
      set choosingVillageLand 1
      output-print " CHOOSING VILLAGE LAND PHASE"
      file-print (word "PHASE|choosing-village-land|" date-and-time)
    ]

    choosePrivateLand? [
      set choosingPrivateLand 1
      output-print " CHOOSING PRIVATE LAND PHASE"
      file-print (word "PHASE|choosing-private-land|" date-and-time)
    ]

    [
      ;;Run environmental, spatial and non-spatial functions.  Phase indicator in input files should specify whether they happen or not
      run-non-spatial-functions
      run-spatial-functions
      
      set currentRound 1
      set currentPhase 1

      output-print " BEGINNING LAND USE PHASES"
      file-print (word "PHASE|beginning-land-use|" date-and-time)

      
      ;;Update land use options for patches
      update-choices-patches
      
      ;;update the effort endowment
      set playerCurrentResources n-values numPlayers [endowment]
         
      ;;update appearance
      ask patches with [inGame?] [
        update-patch-image
        set pcolor update-patch-color
      ]

      
    ]

    )


  foreach n-values (numPlayers) [ ?1 ->  ?1] [ ?1 ->
    update-all-resources ?1
  ]

  set gameInProgress 1

  

  ;;add a round counter
  create-scorecards 1 [setxy (- 3.3) 6.9 set label (word currentRound " - " currentPhase) set identity "roundCounter"]


end

to set-initial-conditions

  let totalPatches count patches with [inGame?]

  foreach sort-on [conditionID] ICs [
    currentCondition ->

    let currentVariable [variable] of currentCondition
    let currentType [conditionType] of currentCondition
    let currentProbability [probability] of currentCondition
    let currentOnlyIf [onlyIf] of currentCondition
    let currentNotIf [notIf] of currentCondition
    let currentValueMode [valueMode] of currentCondition
    let currentValueExpression [valueExpression] of currentCondition
    let currentMin [minValue] of currentCondition
    let currentMax [maxValue] of currentCondition

    ;; begin with all in-game patches
    let allowedPatches patches with [inGame?]

    ;; keep only patches satisfying ALL onlyIf conditions
    foreach currentOnlyIf [
      currentReporter ->
      set allowedPatches allowedPatches with [
        
        runresult currentReporter
      ]
    ]

    ;; remove patches satisfying ANY notIf condition
    foreach currentNotIf [
      currentReporter ->
      set allowedPatches allowedPatches with [
        
        not runresult currentReporter
      ]
    ]

    ;; calculate number of patches to initialize
    let currentCount round (currentProbability * count allowedPatches)

    if any? allowedPatches [
      ask n-of min (list (count allowedPatches) currentCount) allowedPatches [

        ;; fixed values
        if currentValueMode = "fixed" [
          run (word "set " currentVariable " " currentValueExpression)
        ]

        ;; expression values
        if currentValueMode = "expression" [
          let currentValue runresult currentValueExpression
          run (word "set " currentVariable " " currentValue)
        ]

        ;; uniform random numeric value
        if currentValueMode = "uniform" [
          let low currentMin
          let high currentMax

          if is-string? low [ set low runresult low ]
          if is-string? high [ set high runresult high ]

          let currentValue low + random-float (high - low)
          run (word "set " currentVariable " " currentValue)
        ]

        ;; integer random numeric value, inclusive
        if currentValueMode = "integer" [
          let low currentMin
          let high currentMax

          if is-string? low [ set low runresult low ]
          if is-string? high [ set high runresult high ]

          let currentValue low + random (high - low + 1)
          run (word "set " currentVariable " " currentValue)
        ]
      ]
    ]
  ]
end
to set-game-parameters

  ;; this procedure takes the list of parameters names and values and processes them for use in the current game

  ;; take the current game's set of parameters
  let currentGameParameters item 0 currentSessionParameters
  set currentSessionParameters sublist currentSessionParameters 1 length currentSessionParameters

  ;; there are two lists - one with variable names, one with values
  (foreach inputFileLabels currentGameParameters [ [?1 ?2] -> ;; first element is variable name, second element is value

    ;; we use a 'parameter handled' structure to avoid having nested foreach statements
    set parameterHandled 0

    ;; requirement list and phase shown list may come in as a single value, or may be multiple values
      if parameterHandled = 0 and (?1 = "villageMembership" or ?1 = "patch_color_min" or ?1 = "patch_color_max") [  ;; any cases here that are lists
        file-print (word ?1 ": " ?2 )
        let currentParameter []
        set currentParameter (word "set " ?1 " (list " ?2 ")" )

        run currentParameter
        set parameterHandled 1
      ]

        ;; all other cases not specified above are handled as below - the parameter of the same name is set to the specified value
      if parameterHandled = 0 [  ;; any other case
        ;;output-print (word ?1 ": " ?2 )
        file-print (word ?1 ": " ?2 )
        let currentParameter []
        ifelse is-string? ?2 [
          set currentParameter (word "set " ?1 "  \"" ?2 "\"" )
        ][
          set currentParameter (word "set " ?1 " " ?2 )
        ]
     
        run currentParameter
        set parameterHandled 1
      ]

  ])
  file-print ""

  output-print " "
  output-print " "



end

to listen

  ;; this is the main message processing procedure for the game.  this procedure responds to hubnet messages, one at a time, as long as the 'Listen Clients' button is down
  ;; where appropriate, this procedure can be made easier to read by exporting the response to the message case to its own procedure

  ;; while there are messages to be processed
  while [hubnet-message-waiting?] [

    ;; we use a 'message addressed' flag to avoid having to nest foreach loops (there is no switch/case structure in netlogo)
    ;; the procedure steps through each case from top to bottom until it finds criteria that fit.  it then executes that code and marks the message addressed
    ;; it is CRITICAL that you order the cases correctly - from MOST SPECIFIC to LEAST SPECIFIC - if there is any ambiguity in interpreting the message
    ;; e.g., where you have a button or other feature that sits within a larger clickable area, list the case for the button first, then the larger area surrounding it
    set messageAddressed 0

    ;; get the next message in the queue
    hubnet-fetch-message



    ;; CASE 1 and CASE 2 messages are responses to messages of players coming in and out of the game.  hopefully, what's there is a good fit to your purpose

    ;; CASE 3  are responses to a click/tap from a player.

    ;; CASE 4  are 'mouse up' responses after clicking, which at present we are not using.  these are helpful to make use of 'mouse drag' actions

    ;; CASE 5  are otherwise unhandled messages

    ;; CASE 1 if the message is that someone has entered the game
    if (hubnet-enter-message? and messageAddressed = 0)[

      ;; CASE 1.1 if the player has already been in the game, link them back in.  if the player is new, set them up to join
      ifelse (member? hubnet-message-source playerNames ) [

        ;; pre-existing player whose connection cut out
        let newMessage word hubnet-message-source " is back."
        hubnet-broadcast-message newMessage

        ;; give the player the current game information
        let currentMessagePosition (position hubnet-message-source playerNames);
        let currentPlayer currentMessagePosition + 1
        send-game-info currentMessagePosition

      ] ;; end previous player re-entering code

      [ ;; CASE 1.2 otherwise it's a new player trying to join

        ;; new players can only get registered if a game isn't underway
        if (gameInProgress = 0) [  ;;only let people join if we are between games


          ;; register the player name
          set playerNames lput hubnet-message-source playerNames


          ;; add the new player, and give them a color
            set numPlayers numPlayers + 1
          set playerPosition lput numPlayers playerPosition
          set playerColor lput (item (numPlayers - 1) colorList) playerColor

          ;; let everyone know
          let newMessage word hubnet-message-source " has joined the game."
          hubnet-broadcast-message newMessage
          ;file-print (word hubnet-message-source " has joined the game as Player " numPlayers " at " date-and-time)

        ]  ;; end new player code
      ] ;; end ifelse CASE 1.1 / CASE 1.2

      ;; mark this message as done
      set messageAddressed 1
    ] ;; end CASE 1

    ;; CASE 2 if the message is that someone left
    if (hubnet-exit-message? and messageAddressed = 0)[

      ;; nothing to do but let people know
      let newMessage word hubnet-message-source " has left.  Waiting."
      hubnet-broadcast-message newMessage

      ;; mark the message done
      set messageAddressed 1
    ] ;; end CASE 2

    ;;CASE 3 the remaining cases are messages that something has been tapped, which are only processed if 1) a game is underway, 2) the message hasn't been addressed earlier, and 3) the player is in the game
    if (gameInProgress = 1 and messageAddressed = 0 and (member? hubnet-message-source playerNames))[

      ;; identify the sender
      let currentMessagePosition (position hubnet-message-source playerNames);  ;;who the message is coming from, indexed from 0
      let currentPlayer (currentMessagePosition + 1); ;;who the player is, indexed from 1

      if (hubnet-message-tag = "View" )  [  ;; the current player tapped something in the view


        ;;identify the patch
        let xPatch (item 0 hubnet-message)
        let yPatch (item 1 hubnet-message)
        let xPixel (xPatch - min-pxcor + 0.5) * patch-size
        let yPixel (max-pycor + 0.5 - yPatch) * patch-size

        let currentPXCor [pxcor] of patch xPatch yPatch
        let currentPYCor [pycor] of patch xPatch yPatch

        let patchInGame [inGame?] of patch xPatch yPatch
        let notYetConfirmed? (item (currentPlayer - 1) playerConfirm = 0)
        let currentVillage 0
        let patchVillage 0
        if  chooseVillageLand? [
          set currentVillage item (currentPlayer - 1) villageMembership
          set patchVillage [village] of patch xPatch yPatch
        ]
        let inVillage true
        if patchVillage > 0 and patchVillage != currentVillage [set inVillage false]
        let otherOwner false
        let currentOwner [ownedBy] of patch xPatch yPatch
        if currentOwner > 0 and currentOwner != currentPlayer [set otherOwner true]

        ;; CASE 3.0 if the tap is selecting pasture as shared or not
        ;; if it is the choosingSharedLand phase and the player taps a pasture, toggle the selection (patches whose x is >= 0 are pasture)
        if (xPatch >= -0.5 and messageAddressed = 0 and (choosingVillageLand = 1)) and notYetConfirmed? [

          output-print "Tap Case 3.0"
          ask patch xPatch yPatch [
            (ifelse
              selected? and inVillage [
                set selected? false
                set village -99
                ask integer-agents-here with [ID = "villageID"] [die]
                file-print (word "VILLAGE|" currentRound "|" currentPhase "|" currentPlayer "|" pxcor "|" pycor "|unselected|" date-and-time)
            ]
              not selected? [
                set selected? true
                set village currentVillage
                integer-as-agents currentVillage  0.25 white pxcor - 0.25 pycor - 0.25 ( n-values numPlayers [ i -> i ]) "villageID"
                file-print (word "VILLAGE|" currentRound "|" currentPhase "|" currentPlayer "|" pxcor "|" pycor "|selected|" date-and-time)
            ])
            set pcolor update-patch-color
          ]
          ;; message is done
          set messageAddressed 1

        ]

        ;; CASE 3.1 if the tap is selecting pasture as own home or not
        ;; if it is the choosingSharedLand phase and the player taps a pasture, toggle the selection (patches whose x is >= 0 are pasture)
        if (xPatch >= -0.5 and messageAddressed = 0 and (choosingPrivateLand = 1)) and notYetConfirmed? [
          output-print "Tap Case 3.1"
          ask patch xPatch yPatch [
            ifelse selected? and selectedBy = currentPlayer [
              set selected? false
              set selectedBy -9999
              file-print (word "PRIVATE|" currentRound "|" currentPhase "|" currentPlayer "|" pxcor "|" pycor "|unselected|" date-and-time)

            ] [

              if count patches with [selectedBy = currentPlayer] < maxPrivateSquares and inVillage [
                set selected? true
                set selectedBy currentPlayer
                file-print (word "PRIVATE|" currentRound "|" currentPhase "|" currentPlayer "|" pxcor "|" pycor "|selected|" date-and-time)

              ]
            ]
            set pcolor update-patch-color

          ]


          ;; message is done
          set messageAddressed 1

        ]

        ;; CASE 3.2 if the tap is selecting a square to make an action on
        if (patchInGame) and choosingPrivateLand = 0 and choosingVillageLand = 0 and currentInformationScreen = 0 and notYetConfirmed? [
          output-print "Tap Case 3.2"
          ask patch xPatch yPatch [
            if (not selected? or (selected? and selectedBy = currentPlayer)) and (inVillage and not otherOwner) [
              ;; this patch is eligible to be manipulated by the current player

              set currentChoice update-current-choice currentPlayer


              ifelse currentChoice > 0 [
                set selected? true
                set selectedBy currentPlayer
                let myCurrentChoice currentChoice
                let currentChoiceEffort [effort] of (one-of actions with [myCurrentChoice = actionID])
                
                set currentEffort ifelse-value (is-number? currentChoiceEffort) 
                  [currentChoiceEffort]
                  [runresult currentChoiceEffort]


              ][
                set selected? false
                set selectedBy -9999
                set currentEffort -99

              ]

              update-all-resources (currentPlayer - 1)
          
              update-patch-image
              set pcolor update-patch-color

              file-print (word "CHOICE|" currentRound "|" currentPhase "|" currentPlayer "|" pxcor "|" pycor "|" currentChoice "|" date-and-time)

            ]


          set pcolor update-patch-color

          ]

          ;; message is done
          set messageAddressed 1
        ]



        ;; CASE 3.3 if the tap is on the confirm button
        if ( clicked-area confirm_area and messageAddressed = 0)[

          ;; mark the confirm and record
          let newMessage word (item (currentPlayer - 1) playerNames) " clicked confirm."
          hubnet-broadcast-message newMessage
          output-print newMessage
          file-print (word "CONFIRM|" currentRound "|" currentPhase "|" currentPlayer "|" date-and-time)

          if (notYetConfirmed?) [;; hasn't already confirmed
            confirm-actions currentPlayer
          ]
          ;; mark message done
          set messageAddressed 1
        ] ;; end 3.3



      ] ;; end all cases for clicks within the  "view"


    ] ;; end all CASE 3 messages

    ;; CASE 4 - Mouse up after a click message
    if (gameInProgress = 1 and messageAddressed = 0 and hubnet-message-tag = "Mouse Up") [

     ;; no need to do anything
     set messageAddressed 1
    ]

    if (gameInProgress = 1 and messageAddressed = 0) [
      ;; CASE 5 if the message still hasn't been addressed, it means players clicked in a place that they weren't meant to - ignore it
      set messageAddressed 1
      output-print "Unhandled message"

    ]
  ]


end

to-report update-current-choice [currentPlayer]

  let tempChoice currentChoice

 
  
  let currentSpend 0
  
  if tempChoice > 0 [  
    
    set currentSpend ifelse-value (is-number? [effort] of one-of actions with [actionID = tempChoice]) [[effort] of one-of actions with [actionID = tempChoice]] [runresult [effort] of one-of actions with [actionID = tempChoice]]
  ]

 
  ;;construct a list that includes only things the player can do within their budget constraint.  the cost allocated to the CURRENT CHOICE should be added back to the budget, since we would no longer be doing it
  let currentBudget (item (currentPlayer - 1) playerCurrentResources) + currentSpend
  let tempLandChoices landChoices
  
  set tempLandChoices filter [a ->  (a > 0 and (ifelse-value (is-number? [effort] of one-of actions with [actionID = a]) [[effort] of one-of actions with [actionID = a]] [runresult [effort] of one-of actions with [actionID = a]] ) <= currentBudget) or a < 0] tempLandChoices


  ;;if the current choice is in the current list, start there + 1
  ;;if the current choice is not in the current list, start at the beginning

  let currentPosition position tempChoice tempLandChoices
  ifelse currentPosition = false [
    ;;current choice is not in the list
    set currentPosition 0
    set tempChoice item currentPosition tempLandChoices

  ][
    ;;current choice is in the list
    set currentPosition currentPosition + 1
    if currentPosition > ((length tempLandChoices) - 1) [set currentPosition 0]
    set tempChoice item currentPosition tempLandChoices

  ]


  report tempChoice



end

to update-patch-image

  ask visuals-here [die]
  ;; if the patch has 'do nothing' for the action, then show its state
  ;; if the patch has an action selected, then show that
  
  ifelse currentChoice > 0 [
   ;; we are showing an action
    let myChoice currentChoice
    sprout-visuals 1 [
      set size 1 
      set shape [imageName] of one-of actions with [actionID = myChoice]
    ]
    ask ownerBoxes-here [set color item (([selectedBy] of patch-here) - 1) playerColor set hidden? false]
    ask displayTurtles-here with [transparent? = TRUE] [ palette:set-transparency 90 ]
  ][
    ask ownerBoxes-here [set hidden? true]
    
    ;;undo any transparency
    ask displayTurtles-here with [transparent? = TRUE] [ palette:set-transparency 0 ]

    ;; we are showing a state
    let bestMatchState 0
    foreach sort-on [stateID] landStates [ currentLandState ->
      let currentFlags [flags] of currentLandState
      let tempMatch true
      if length currentFlags > 0 [
        foreach currentFlags [ tempFlag ->
          if (not runresult tempFlag) [set tempMatch false]
        ]
      ]
      if tempMatch [set bestMatchState [stateID] of currentLandState]

    ]

    if bestMatchState > 0 [
      let currentVisual one-of landStates with [stateID = bestMatchState]
      if not empty? [imageName] of currentVisual [
        sprout-visuals 1 [
          set size 1 
          set shape [imageName] of currentVisual
          if not empty? [stateColor] of currentVisual [

            set color runresult ([stateColor] of currentVisual)
          ]
        
        ]
      ]
    ]

    ;;now display any displayTurtles that fit conditions
    foreach sort-on [turtleID] landDisplays [ currentTurtle ->
      let currentCount [countMeasure] of currentTurtle

      set currentCount runresult currentCount

      let currentMobile [mobile?] of currentTurtle
      let currentTransparent [transparent?] of currentTurtle


      (ifelse is-list? currentCount [ ;;this has a value for each player
        foreach n-values numPlayers [ ?1 -> ?1 ] [ ?1 ->

          let currentPlayerCount item ?1 currentCount

          if currentPlayerCount > 0 [

            let currentID [turtleID] of currentTurtle
            let currentNeeds currentPlayerCount - count displayTurtles-here with [identity = currentID]

            sprout-displayTurtles currentNeeds [
              setxy (pxcor - 0.5 + random-float 1) (pycor - 0.5 + random-float 1)
              set size [turtleSizeMin] of currentTurtle + (random-float 1) * ([turtleSizeMax - turtleSizeMin] of currentTurtle)
              set shape [imageName] of currentTurtle
              set identity ([turtleID] of currentTurtle)
              set mobile? currentMobile
              set transparent? currentTransparent
              set owner ?1 + 1
              set color item ?1 playerColor

            ]

        ]

        ]

      ]
        is-number? currentCount [
          if currentCount > 0 [

            let currentID [turtleID] of currentTurtle
            let currentNeeds currentCount - count displayTurtles-here with [identity = currentID]

            sprout-displayTurtles currentNeeds [
              setxy (pxcor - 0.5 + random-float 1) (pycor - 0.5 + random-float 1)
              set size [turtleSizeMin] of currentTurtle + (random-float 1) * ([turtleSizeMax - turtleSizeMin] of currentTurtle)
              set shape [imageName] of currentTurtle
              set identity ([turtleID] of currentTurtle)
              set transparent? currentTransparent
              set mobile? currentMobile

            ]

          ]
        ]
      )

    ]

  ]

end

to read-initial-condition-file

  ;; try to read in the input parameter data - stop if the file doesn't exist
  if not file-exists? initialConditionListFileName [ ;;if game parameter file is incorrect
    user-message "Please enter valid file name for initial conditions data"
    stop
  ]

  ;; open the file and read it in line by line
  let delimiter detect-delimiter initialConditionListFileName
  set icInputs (csv:from-file initialConditionListFileName delimiter)
  set icPropertyLabels item 0 icInputs
  foreach but-first icInputs [ ?0 ->

    let currentIC ?0

    create-ICs 1 [
    ;; there are two lists - one with variable names, one with values
    (foreach icPropertyLabels currentIC [ [?1 ?2] -> ;; first element is variable name, second element is value

      ;; we use a 'parameter handled' structure to avoid having nested foreach statements, in case there are different ways to handle inputs
      set parameterHandled 0

      ;; requirement list and phase shown list may come in as a single value, or may be multiple values
      if parameterHandled = 0 and (?1 = "onlyIf" or ?1 = "notIf") [  ;; any other case
        file-print (word ?1 ": " ?2 )
        let currentParameter []
        set currentParameter (word "set " ?1 " (list " ?2 ")" )

     
        run currentParameter
        set parameterHandled 1
      ]

        ;; all other cases not specified above are handled as below - the parameter of the same name is set to the specified value
      if parameterHandled = 0 [  ;; any other case
        ;;output-print (word ?1 ": " ?2 )
        file-print (word ?1 ": " ?2 )
        let currentParameter []
        ifelse is-string? ?2 [
          set currentParameter (word "set " ?1 "  \"" ?2 "\"" )
        ][
          set currentParameter (word "set " ?1 " " ?2 )
        ]
 
        run currentParameter
         
        set parameterHandled 1
      ]

    ])

    ]
  ]


  output-print "initial condition file read."


end

