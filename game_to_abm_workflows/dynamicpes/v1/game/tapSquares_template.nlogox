to read-action-file

  ;; try to read in the input parameter data - stop if the file doesn't exist
  if not file-exists? actionListFileName [ ;;if game parameter file is incorrect
    user-message "Please enter valid file name for action data"
    stop
  ]

  ;; open the file and read it in line by line
  let delimiter detect-delimiter actionListFileName
  set actionInputs (csv:from-file actionListFileName delimiter)
  set actionPropertyLabels item 0 actionInputs
  foreach but-first actionInputs [ ?0 ->

    let currentaction ?0

    create-actions 1 [
    ;; there are two lists - one with variable names, one with values
    (foreach actionPropertyLabels currentAction [ [?1 ?2] -> ;; first element is variable name, second element is value

      ;; we use a 'parameter handled' structure to avoid having nested foreach statements, in case there are different ways to handle inputs
      set parameterHandled 0

      ;; requirement list and phase shown list may come in as a single value, or may be multiple values
      if parameterHandled = 0 and (?1 = "phaseAvailable" or ?1 = "round_play" or ?1 = "changesAllowed" or ?1 = "flags") [  ;; any other case
        file-print (word ?1 ": " ?2 )
        let currentParameter []
        set currentParameter (word "set " ?1 " (list " ?2 ")" )

        run currentParameter
        set parameterHandled 1
      ]

        ;; all other cases not specified above are handled as below - the parameter of the same name is set to the specified value
      if parameterHandled = 0 [  ;; any other case
        ;;output-print (word ?1 ": " ?2 )
        file-print (word ?1 ": " ?2 )
        let currentParameter []
        ifelse is-string? ?2 [
          set currentParameter (word "set " ?1 "  \"" ?2 "\"" )
        ][
          set currentParameter (word "set " ?1 " " ?2 )
        ]
        run currentParameter
        set parameterHandled 1
      ]

    ])

    ]
  ]

  set actionEffortList n-values (count actions) [0]
  foreach n-values (count actions) [ ?1 -> ?1 + 1] [ ?1 ->

    ask one-of actions with [actionID = ?1] [
      set actionEffortList replace-item (?1 - 1) actionEffortList effort
     ]

  ]

  output-print "action file read."


end

to send-game-info [currentPosition]

  ;; sends current, player-specific game info to the specified player.  this is useful if the player has left the game and returned, so that any view overrides are re-established.
  ;;example:  ask dayBoxes [hubnet-send-override (item currentPosition playerNames) self "hidden?" [true]]

  ask integer-agents [
    if (not member? currentPosition visibleTo) [
      hubnet-send-override  (item (currentPosition) playerNames) self "shape" ["blank"]
    ]

  ]

  ask panelEdges [
      hubnet-send-override (item (currentPosition) playerNames) self "color" [item currentPosition playerColor]
  ]


  if item currentPosition playerConfirm = 1 [
    ask buttons with [identity = "confirm"] [hubnet-send-override (item currentPosition playerNames) self "color" [confirm-down-color]]
  ]



end

to run-non-spatial-functions

  ;;for each function
  foreach sort-on [functionID] nonSpatialFunctions [ currentNonSpatialFunction ->

    ask currentNonSpatialFunction [
      ;;if it's the right phase


      if (member? currentPhase phase) and (member? currentRound round_play) [


        run expression


      ]
    ]
  ]

end

to run-spatial-functions

  ;;for each function
  foreach sort-on [functionID] spatialFunctions [ currentSpatialFunction ->

    ask currentSpatialFunction [
      ;;if it's the right phase
      if member? currentPhase phase and member? currentRound round_play [
        let currentTrigger trigger
        let currentLocalVariables localVariables
        let currentLocalTargets localTargets
        let currentExpression expression
        let currentX xOffset
        let currentY yOffset
       

        ;;for each patch
        ask patches with [inGame?] [
          ;;if the trigger is met
          if runresult currentTrigger [
            ;;if there are local variables to set
            if length currentLocalVariables > 0 [
              ;;set local variables

              
              ;(foreach currentLocalVariables currentLocalTargets [[a b] -> run (word "let " a " " b)] )
              (foreach currentLocalVariables currentLocalTargets [[a b] ->  run (word "set " a " " b)] )
              
            ]

            ;;evaluate the expression in the appropriate patch

            if (not (patch-at currentX currentY = nobody)) [
              ask patch-at currentX currentY [run currentExpression]
            ]

          ]
        ]

      ]
    ]
  ]

end

to run-score-function

  ask visuals with [identity = "scoring"] [die]
  ask integer-agents with [ID = "scoring"] [die]

  set playerCurrentScore n-values numPlayers [0]


  let countRows 0
  ;;for each function
  foreach sort-on [scoreID] scoringFunctions [ currentScoreFunction ->

    ask currentScoreFunction [
      ;;if it's the right phase
      if (member? currentPhase phase) and (member? currentRound round_play) [
        let currentProperty property
        let currentValue value
        if is-string? currentValue [set currentValue runresult currentValue]
        let currentLocalTarget localTarget
        let currentPlayerTarget playerTarget
        let currentShow? show?
        let currentImageName imageName
        let currentColumn column
        let currentOperation operation
        let currentPlayerMarker playerMarker
        let currentTrigger trigger
        let currentLoop? loop?
        let currentPatchLevel? patchLevel?


        if-else currentPatchLevel? [ ;;if this scoring is being summed across patches
                                     ;;for each patch
          ask patches with [inGame?] [

  
            ;;check if the trigger condition fits this patch, if there is a trigger
            let runPatch true
            if not empty? currentTrigger [
              if not runresult currentTrigger [set runPatch false]
            ]


            if runPatch [


              if-else currentLoop?
              [ ;;if block of if-else currentLoop? run if this target is looped for all players

                foreach n-values (numPlayers) [?1 -> ?1 ] [ playerNumber ->

 

                  ;;calculate the score element
                  let currentScore 0
                  if not empty? currentProperty [

                    set currentScore runresult (word "item " playerNumber " " currentProperty)

                  ]
    

                  if currentScore = true [set currentScore 1]
                  if currentScore = false [set currentScore 0]

                  set currentScore currentScore * currentValue


                  ;;assign element to local target if specified
                  if not empty? currentLocalTarget [

                    (ifelse
                      currentOperation = "add" [

                        run (word "set tempValue item " playerNumber " " currentLocalTarget)

                        run (word "set " currentLocalTarget " replace-item " playerNumber " " currentLocalTarget " (tempValue + " currentScore ")")

                      ]
                      currentOperation = "set" [

                        run (word "set " currentLocalTarget " replace-item " playerNumber " " currentLocalTarget " " currentScore)
                      ]
                    )

                  ]


                  ;;assign element to player target if specified
                  if not empty? currentPlayerTarget [

                    (ifelse
                      currentOperation = "add" [
                        set tempValue 0

                        run (word "set tempValue item " playerNumber " " currentPlayerTarget)
                        run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " (tempValue + " currentScore ")")

                      ]
                      currentOperation = "set" [

                        run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " " currentScore)
                      ]
                    )

                  ]

                ]



                ;;end of if block of if-else currentLoop? that is run if this is looped for all players
              ]

              [ ;;else block of if-else currentLoop? run if this target is not looped for all players

                   

                ;;calculate the score element
                let currentScore 0
                if not empty? currentProperty [
                  set currentScore runresult currentProperty
                ]

     

                if currentScore = true [set currentScore 1]
                if currentScore = false [set currentScore 0]

                set currentScore currentScore * currentValue

                
                ;;assign element to local target if specified
                if not empty? currentLocalTarget [
                  (ifelse
                    currentOperation = "add" [

                      run (word "set " currentLocalTarget " " currentLocalTarget " + " currentScore)

                    ]
                    currentOperation = "set" [

                      run (word "set " currentLocalTarget " " currentScore)
                    ]
                  )

                ]




                
                ;;assign element to player target if specified
                if not empty? currentPlayerTarget [
                  let currentSelector runresult currentPlayerMarker

                     

                  (ifelse
                    currentOperation = "add" [
                      set tempValue 0

                      run (word "set tempValue item " (currentSelector - 1) " " currentPlayerTarget)
                      run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " (tempValue + " currentScore ")")
                     ;;run (word "set tempValue item " (currentSelector) " " currentPlayerTarget)
                      ;;run (word "set " currentPlayerTarget " replace-item " (currentSelector) " " currentPlayerTarget " (tempValue + " currentScore ")")

                    ]
                    currentOperation = "set" [

                      run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " " currentScore)
                      ;;run (word "set " currentPlayerTarget " replace-item " (currentSelector) " " currentPlayerTarget " " currentScore)
                    ]
                  )

                ]
                

                ;;end of else block of if-else currentLoop?
              ]




            ]
          ]

        ]

        [ ;; else block for patchLevel?  - runs for non-patch-level scoring


          if-else currentLoop?
              [ ;;if block of if-else currentLoop? run if this target is looped for all players

                foreach n-values (numPlayers) [?1 -> ?1 ] [ playerNumber ->


     
                  ;;calculate the score element
                  let currentScore 0
                  if not empty? currentProperty [

                    set currentScore runresult (word "item " playerNumber " " currentProperty)

                  ]

        
                  if currentScore = true [set currentScore 1]
                  if currentScore = false [set currentScore 0]

                  set currentScore currentScore * currentValue


                  ;;assign element to player target if specified
                  if not empty? currentPlayerTarget [

                    (ifelse
                      currentOperation = "add" [
                        set tempValue 0

                        run (word "set tempValue item " playerNumber " " currentPlayerTarget)
                        run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " (tempValue + " currentScore ")")

                      ]
                      currentOperation = "set" [

                        run (word "set " currentPlayerTarget " replace-item " playerNumber " " currentPlayerTarget " " currentScore)
                      ]
                    )

                  ]

                ]



                ;;end of if block of if-else currentLoop? that is run if this is looped for all players
              ]

              [ ;;else block of if-else currentLoop? run if this target is not looped for all players

     

                ;;calculate the score element
                let currentScore 0
                if not empty? currentProperty [
                  set currentScore runresult currentProperty
                ]

       

                if currentScore = true [set currentScore 1]
                if currentScore = false [set currentScore 0]

                set currentScore currentScore * currentValue


                ;;assign element to player target if specified
                if not empty? currentPlayerTarget [
                  let currentSelector runresult currentPlayerMarker
              
     

                  (ifelse
                    currentOperation = "add" [
                      set tempValue 0

                      run (word "set tempValue item " (currentSelector - 1) " " currentPlayerTarget)
                      run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " (tempValue + " currentScore ")")
                      ;;run (word "set tempValue item " (currentSelector) " " currentPlayerTarget)
                      ;;run (word "set " currentPlayerTarget " replace-item " (currentSelector) " " currentPlayerTarget " (tempValue + " currentScore ")")

                    ]
                    currentOperation = "set" [

                      run (word "set " currentPlayerTarget " replace-item " (currentSelector - 1) " " currentPlayerTarget " " currentScore)
                      ;;run (word "set " currentPlayerTarget " replace-item " (currentSelector) " " currentPlayerTarget " " currentScore)
                    ]
                  )

                ]
                ;;end of else block of if-else currentLoop?
              ]

        ] ;;; end of else block for patchLevel?

        ;;display the score elements if required

        if currentShow? [
          foreach n-values (numPlayers) [?1 -> ?1 ] [ playerNumber ->

            set tempScoring 0

            if not empty? currentLocalTarget [
              ;;for local targets, sum up all local values, by player

              if-else currentLoop?  ;;sum up local targets differently if they are scalars vs lists for all players
              [ run (word "set tempScoring sum [item " playerNumber " " currentLocalTarget "] of patches with [inGame? and " currentTrigger "]")]
              [ run (word "set tempScoring sum [" currentLocalTarget "] of patches with [inGame? and " currentPlayerMarker " = " (playerNumber + 1) " and " currentTrigger "]")]



            ]

            
            if not empty? currentPlayerTarget [
              ;;for player targets, access the current value of the player target

              run (word "set tempScoring item " playerNumber " " currentPlayerTarget)

           ]
            

            
            if not empty? currentImageName [
              hatch-visuals 1 [
                set shape currentImageName
                set identity "scoring"
                set size panel_row_size
                set visibleTo []
                setxy (- patches_panel + 0.5) (panel_scoring_max - (countRows + 0.5) * panel_row_size)
                foreach n-values (numPlayers) [?2 -> ?2 ] [ ?2 ->
                  if-else (playerNumber = ?2) [
                    set visibleTo lput ?2 visibleTo
                  ] [
                    hubnet-send-override  (item (?2) playerNames) self "shape" ["blank"]
                  ]
                ]
              ]
            ]
            
            integer-as-agents  tempScoring panel_row_size green (- patches_panel + 0.5 + currentColumn) (panel_scoring_max - (countRows + 0.5) * panel_row_size) (list playerNumber) "scoring"


          ]

          set countRows countRows + 1
        ]

      ]
    ]
  ]

  foreach n-values (numPlayers) [?1 -> ?1] [ ?1 ->
    let currentScore item ?1 playerTotalScore
    set playerTotalScore replace-item ?1 playerTotalScore (currentScore + item ?1 playerCurrentScore)
    integer-as-agents (item (?1 ) playerTotalScore) 1 green (- patches_panel * 0.5) (patches_game * 0.025) (list ?1) "scoring"

  ]

end

to advance-to-next-round


  ;; called once at the end of every phase, once all players have clicked 'confirm'.  depending on the phases listed for the current turn, different things happen

  ;; it may be called to advance from identifying village or private land, to end a phase of land use selection, or to end the display of between-round information

  ;; use advanceHandled? as a flag to mark a particular case as being handled
  let advanceHandled? false
  let readyForNextRound? false


  
  ;;CASE 1 - ADVANCING OUT OF CHOOSING SHARED LAND
  if (not advanceHandled? and choosingVillageLand = 1) [

    ;;Run environmental, spatial and non-spatial functions.  Phase indicator in input files should specify whether they happen or not
    run-non-spatial-functions
    run-spatial-functions


    ;;mark us out of the choosing shared land phase
    set choosingVillageLand 0



    ;;mark out the shared village
    ask patches with [selected?] [set selected? false set shared? true file-print (word "VILLAGECONFIRMED|" village "|" pxcor "|" pycor "|confirmed-shared|" date-and-time) set playerAccess item (village - 1) villageMemberList]
    ask patches [set pcolor update-patch-color]
    make-shared-borders "line-thick" village_border_color "village" false

    ;;reset player confirms
    foreach playerPosition [ ?1 ->
      set playerConfirm replace-item (?1 - 1) playerConfirm 0
      send-game-info (?1 - 1)
    ]

 

    ;;clear any overrides before moving to next phase
    foreach playerPosition [ ?1 ->
      ask patches with [inGame?] [hubnet-clear-override (item (?1 - 1) playerNames) self "pcolor"]
    ]

    ;;if the game includes marking of private lands, move to that; otherwise  move into first actual-time phase
    ifelse choosePrivateLand? [
      set choosingPrivateLand 1
      output-print " CHOOSING PRIVATE LAND PHASE"
      file-print (word "PHASE|choosing-private-land|" date-and-time)
      set currentPhase (currentPhase + 1)
    ] [
      set currentRound 1
      set currentPhase 1

      output-print " BEGINNING LAND USE PHASES"
      file-print (word "PHASE|beginning-land-use|" date-and-time)
    ]



    ;;update appearance
    ask patches with [inGame?] [
      update-patch-image
      set pcolor update-patch-color
    ]

    ;;mark the phase as advanced
    set advanceHandled? true
  ]


  ;;CASE 2 - ADVANCING OUT OF CHOOSING PRIVATE LAND
  if (not advanceHandled? and choosingPrivateLand = 1) [

     ;;Run environmental, spatial and non-spatial functions.  Phase indicator in input files should specify whether they happen or not
    run-non-spatial-functions
    run-spatial-functions


    ;;mark us out of the choosing private land phase
    set choosingPrivateLand 0

    ;;mark out the private land
    ask patches with [selected?] [set selected? false set shared? false set ownedBy selectedBy file-print (word "PRIVATECONFIRMED|" selectedBy "|" pxcor "|" pycor "|confirmed-owned|" date-and-time) set playerAccess (list selectedBy)]
    ask patches [set pcolor update-patch-color]
    make-private-borders false

    ;;reset player confirms
    foreach playerPosition [ ?1 ->
      set playerConfirm replace-item (?1 - 1) playerConfirm 0
      send-game-info (?1 - 1)
    ]


    ;;clear any overrides before moving to next phase
    foreach playerPosition [ ?1 ->
      ask patches with [inGame?] [hubnet-clear-override (item (?1 - 1) playerNames) self "pcolor"]
    ]

    ;;move into first actual-time phase
    set currentRound 1
    set currentPhase 1

    output-print " BEGINNING LAND USE PHASES"
    file-print (word "PHASE|beginning-land-use|" date-and-time)

    ;;Update land use options for patches
    update-choices-patches

    ;;update the effort endowment
    set playerCurrentResources n-values numPlayers [endowment]

    ;;update appearance
    ask patches with [inGame?] [
      update-patch-image
      set pcolor update-patch-color
    ]

    ;;mark the phase as advanced
    set advanceHandled? true
  ]


  ;;CASE 3 - ADVANCING ALONG LAND USE TURNS
  if (not advanceHandled? and currentRound > 0 and currentInformationScreen = 0) [


   
    ;;Run environmental, spatial and non-spatial functions.  Phase indicator in input files should specify whether they happen or not
    run-non-spatial-functions
 
    run-spatial-functions

    ;;Update scores
    run-score-function

    foreach n-values numPlayers [i -> i] [i ->
      file-print (word "SCORE|" currentRound "|" currentPhase "|" (i + 1) "|" (item i playerCurrentScore) "|" (item i playerTotalScore) "|" (item i playerCurrentResources))
    ]
    
    ;;Update land use options for patches
    update-choices-patches

  
    ;;Show summary information
    ifelse count infoScreenFunctions with [(member? currentPhase phase) and (member? currentRound round_play)] > 0 [
      ;;there are summary screens to get through - show the first one and let the message be handled

      set currentInformationScreen 1
      show-information-screen currentInformationScreen
    ] [
      set readyForNextRound? true
    ]

 
    ;;mark the phase as advanced
    set advanceHandled? true


 ]

  

  ;;CASE 4 - ADVANCING SUMMARY INFORMATION
  if (not advanceHandled? and currentInformationScreen > 0) [

   ;;advance to next information screen, or clear and move on
    set currentInformationScreen currentInformationScreen + 1
    ask integer-agents with [ID = "infoScreen"] [die]
    ask displayTurtles with [transparent? = TRUE] [ palette:set-transparency 0 ]

    ifelse currentInformationScreen <= max [screenID] of infoScreenFunctions with [(member? currentPhase phase) and (member? currentRound round_play)]  [

     show-information-screen currentInformationScreen

    ] [
      
      set readyForNextRound? true
      
    ]
  

    ;;mark the phase as advanced
    set advanceHandled? true
  ]



if readyForNextRound? [
    
 
    set currentInformationScreen 0

    ;;reset actions to 'doing nothing'
    ask patches with [inGame?] [
      set currentChoice -99
      set selectedBy -99
      set selected? false]
    
   
      ;;update appearance
    ask patches with [inGame?] [
      update-patch-image
      set pcolor update-patch-color
      ask integer-agents-here with [ID != "infoScreen"] [set hidden? false]
      
    ]
    ask displayTurtles with [not mobile?] [set hidden? false]
    ask borders [set hidden? false]
    

   
    
    ;;update the round
    set currentPhase (currentPhase + 1)
    if currentPhase > numPhases [
      set currentPhase 1
      set currentRound (currentRound + 1)
    ]
    
    ;;Update land use options for patches
    update-choices-patches
    
    ;;update the effort endowment
    set playerCurrentResources n-values numPlayers [endowment]
    
   
    ;; land ownership/access (ownedBy, village, shared?) is core mechanism
    ;; state, not a game-specific variable like a game's own patchPropertyList
    ;; entries -- it's guaranteed into every STATE| log here regardless of
    ;; whether a given game's own game details.nls remembers to list it,
    ;; the same way CHOICE/CONFIRM/SCORE lines are unconditional and don't
    ;; depend on any game-specific list. remove-duplicates means a game
    ;; that already lists one of these (e.g. "ownedBy") just gets it once,
    ;; not double-logged.
    let corePatchProperties ["ownedBy" "village" "shared?"]
    let allPatchProperties remove-duplicates (sentence corePatchProperties patchPropertyList)
    foreach n-values (length allPatchProperties) [i -> i] [i ->
      ask patches with [inGame?] [file-print (word "STATE|" currentRound "|" currentPhase "|" pxcor "|" pycor "|" (item i allPatchProperties) "|" (runresult (item i allPatchProperties)))]
      ]
    
  ]
 


  ;;Things that get done for all rounds
  foreach playerPosition [ ?1 ->
    ask buttons with [identity = "confirm"] [hubnet-clear-override  (item (position ?1 playerPosition) playerNames) self "color" ]
    update-all-resources (?1 - 1)
  ] ;; end foreach player


  ask integer-agents with [ID = "round"] [die]



  set playerConfirm n-values numPlayers [0]




  ;;update plots
  update-plots

  ;;update the round counter or end the game if we've gone over, once we're past any information screens
  if currentInformationScreen = 0 [
    if-else currentRound <= numRounds [

      ;;update round counters
      ask scorecards with [identity = "roundCounter"] [set label (word currentRound  " - " currentPhase)]


    ][
      end-game
      stop
    ]
  ]


end

to make-panel-border
  ask patches with [pxcor = min-pxcor] [sprout-panelEdges 1 [set heading -90]]
  ask patches with [pxcor = -1] [sprout-panelEdges 1 [set heading 90]]
  ask patches with [(pycor = min-pycor) and (pxcor < 0)] [sprout-panelEdges 1 [set heading 180]]
  ask patches with [(pycor = max-pycor) and (pxcor < 0)] [sprout-panelEdges 1 [set heading 0]]

  ask panelEdges [
    set color white
        foreach (playerPosition) [ ?1 ->
        hubnet-send-override (item (?1 - 1) playerNames) self "color" [item (?1 - 1) playerColor]
      ]
  ]
end

to show-information-screen [currentScreenID]


  let currentScreen one-of infoScreenFunctions with [screenID = currentScreenID]
  let currentLevel [level] of currentScreen
  let currentParameter [parameter] of currentScreen

  
  (ifelse
    currentLevel = "patch" [
      ask patches with [inGame?] [
        let currentValue runresult currentParameter
        ifelse currentValue != 0 [

          let numDigits (floor (log currentValue 10)) + 1

          let digitSize (1 / numDigits)
          let pxOffset 0.5 - (digitSize / 2)

          let itemColor white
          if selectedBy > 0 [set itemColor (item (selectedBy - 1) colorList)]
          if ownedBy > 0 [set itemColor (item (ownedBy - 1) colorList)]
        
          integer-as-agents currentValue 1 itemColor (pxcor - pxOffset) pycor (n-values numPlayers [i -> i]) "infoScreen"
          ask displayTurtles-here with [transparent? = TRUE] [ palette:set-transparency 90 ]

        ] [
          ;; these cells don't have values to show, so dim them a bit to lessen focus
          let currentColor update-patch-color
          foreach n-values (length currentColor) [i -> i] [ ?1 ->
            set currentColor replace-item ?1 currentColor ((item ?1 currentColor) * access_shading)
          ]

          set pcolor currentColor
        ]


      ]

    ]

    currentLevel = "player" [


      ask patches with [inGame?] [

        set pcolor black
        ask visuals-here [die]
        ask displayTurtles-here with [mobile?] [die]
        ask displayTurtles-here with [not mobile?] [set hidden? true]
        ask borders-here [set hidden? true]
        ask ownerBoxes-here [set hidden? true]
        ask integer-agents-here with [ID != "infoScreen"] [set hidden? true]

      ]

      let rowSize (min list 1 (patches_game / numPlayers))
      let topY (patches_game / 2) + (numPlayers / 2) * rowSize

      let currentRow 0
      foreach n-values max villageMembership [?1 -> ?1 + 1 ] [ ?1 ->

        let villageValue 0
        foreach playerPosition [?2 ->

          if item (?2 - 1) villageMembership = ?1 [

    
            let currentValue runresult (word "item " (?2 - 1) " " currentParameter)
            set villageValue villageValue + currentValue
            create-visuals 1 [setxy ((patches_game / 2) - 1) (topY - currentRow * rowSize) set size 1 set color (item (?2 - 1) playerColor) set shape "square"]
            integer-as-agents currentValue 1 green ((patches_game / 2)) (topY - currentRow * rowSize) (n-values numPlayers [i -> i]) "infoScreen"

            ;;is this the last one for this village
            if not member? ?1 sublist villageMembership ?2 numPlayers [
              integer-as-agents villageValue 1 red ((3 * patches_game / 4)) (topY - currentRow * rowSize) (n-values numPlayers [i -> i]) "infoScreen"
            ]

            set currentRow currentRow + 1
          ]

        ]

      ]


    ]

)


end

to update-choices-patches

  ;;update the list of land use choices for this patch for the upcoming round

  ;;the list should contain all actions allowed for this phase, for this patch, given any restrictions

  ;;it will also include a -99 'do nothing' option, allowing the cycle to return to whatever the current state is without taking action

  ;;this list will still be filtered for effort constraints when in use

  ask patches with [inGame?] [
    set landChoices []

    set landChoices lput -99 landChoices

    foreach sort-on [actionID] actions [
    currentAction -> ask currentAction [

        let validAction true
        ;; see if this action is available in this phase
        if not (member? currentPhase phaseAvailable and member? currentRound round_play) [set validAction false]


        ;;run through each of the flags and test them for this patch to see if they are true
        foreach flags [ currentFlag -> if not [runresult currentFlag] of myself [set validAction false] ]

        if validAction [let myID actionID ask myself [set landChoices lput myID landChoices]]

      ]
    ]


  ]

end

to make-private-borders [stamp?]
    ;; make border around shared parcels
  ;; do this using 'border' agents that stamp an image of themselves between patches and then die
  ;; note:  if you have wraparound, the setxy line has to be modified to account for this

  ask patches with [ownedBy > 0] [
    let currentOwner ownedBy
    let x1 pxcor
    let y1 pycor

    sprout-displayTurtles 1 [set mobile? false set size 0.2 setxy pxcor - 0.25 pycor + 0.25 set shape "circle" set color (item (currentOwner - 1) playerColor)]

    ask neighbors4 [
      let x2 pxcor
      let y2 pycor
      let neighborOwner ownedBy
     if neighborOwner != currentOwner  [
       sprout-borders 1 [set color (item (currentOwner - 1) playerColor)
         setxy mean (list x1 x2) mean (list y1 y2)
         ifelse y1 != y2 [set heading 90] [set heading 0]

          if stamp?
          [stamp die]]


      ]
    ]

  ]

end

to-report update-patch-color

  let scaler 1
  if not is-empty-safe? patch_color_property
    [set scaler ifelse-value (is-string? patch_color_property) [runresult patch_color_property] [patch_color_property]]

  let currentColor 0
  if inGame? [
    ;; update appearance of grass patches
    let currentRGB_R max (list 0 (min (list 255 ((item 0 patch_color_min) + scaler * (item 0 patch_color_max - item 0 patch_color_min)))))
    let currentRGB_G max (list 0 (min (list 255 ((item 1 patch_color_min) + scaler * (item 1 patch_color_max - item 1 patch_color_min)))))
    let currentRGB_B max (list 0 (min (list 255 ((item 2 patch_color_min) + scaler * (item 2 patch_color_max - item 2 patch_color_min)))))

    ifelse selected? [
      set currentColor (list (currentRGB_R * selected_shading) (currentRGB_G * selected_shading) (currentRGB_B * selected_shading) )


    ] [
      set currentColor (list currentRGB_R currentRGB_G currentRGB_B)


    ]

  ]

  report currentColor
end

to integer-as-agents [intI sizeI colI posX posY seen_by name]

  let strI (word intI)
  let offset 0
  while [length strI > 0] [
   let currentI first strI
    ask one-of patches [  ;; a little hack to make this procedure usable both in observer and turtle context - ask a patch to do it.
      sprout-integer-agents 1 [
        set visibleTo (list)
        setxy  posX + offset posY
        set size sizeI
        if-else currentI = "-" [
          set shape "num-minus"
        ][

          set shape item (read-from-string currentI) number_shape_list]
        set color colI
        set ID name


        foreach n-values (numPlayers) [?2 -> ?2 ] [ ?2 ->

          if-else (member? ?2 seen_by) [
            set visibleTo lput ?2 visibleTo
          ] [
            hubnet-send-override  (item (?2) playerNames) self "shape" ["blank"]
          ]
        ]


      ]

    ]
    set strI but-first strI

    set offset offset + sizeI * 0.5
  ]


end

to make-shared-borders [borderShape borderColor compareFlag stamp?]
    ;; make border around areas used by one village
  ;; do this using 'border' agents that stamp an image of themselves between patches and then die
  ;; note:  if you have wraparound, the setxy line has to be modified to account for this

  ask patches with [inGame?] [
    let x1 pxcor
    let y1 pycor
    let currentFlag runresult compareFlag
    ;let currentVillage village

    let conditionMet false
    ;;run for this patch if the flag is numeric and defined (above 0), or if the flag is boolean and true
    if is-boolean? currentFlag [if currentFlag [set conditionMet true]]
    if is-number? currentFlag [if currentFlag > 0 [set conditionMet true]]
    if conditionMet [


      ask neighbors4 [
        let x2 pxcor
        let y2 pycor
        let neighborFlag runresult compareFlag
        ;let neighborVillage village

        if currentFlag != neighborFlag  [
          sprout-borders 1 [set color borderColor
            set shape borderShape
            set identity compareFlag
            setxy mean (list x1 x2) mean (list y1 y2)
            (ifelse
              y1 < y2 [set heading 270]
              y1 > y2 [set heading 90]
              x1 < x2 [set heading 0]
              x1 > x2 [set heading 180]
              )

            if stamp? [
              stamp die]
          ]


        ]
    ]]

  ]

end



to make-borders
    ;; make border around pasture parcels
  ;; do this using 'border' agents that stamp an image of themselves between patches and then die
  ;; note:  if you have wraparound, the setxy line has to be modified to account for this


  ask patches with [pxcor >= 0 and pycor < max-pycor] [
    sprout-borders 1 [set color border_color
      setxy pxcor pycor + 0.5
      set heading 90
      stamp die]
  ]

  ask patches with [pxcor >= 0 and pxcor < max-pxcor] [
    sprout-borders 1 [set color border_color
      setxy pxcor + 0.5 pycor
      set heading 0
      stamp die]
  ]
end

to confirm-actions [currentPlayer]

  set playerConfirm replace-item (currentPlayer - 1) playerConfirm 1
  ask buttons with [identity = "confirm"] [hubnet-send-override (item (position currentPlayer playerPosition) playerNames) self "color" [confirm-down-color]]


  if sum playerConfirm = numPlayers [ ;; all players are confirmed, round is over, do end-of-round things
    advance-to-next-round
  ]

end

to-report clicked-area [ current_area ]

  ;; checks the boundaries of a click message against those of a 'button' to see if it was the one clicked

  let xPatch (item 0 hubnet-message)
  let yPatch  (item 1 hubnet-message)
  let xMin item 0 current_area
  let xMax item 0 current_area + item 2 current_area
  let yMin item 1 current_area
  let yMax item 1 current_area + item 3 current_area
  ifelse xPatch > xMin and xPatch < xMax and yPatch > yMin and yPatch < yMax [  ;; player "clicked"  the current button
    report true
  ] [
    report false
  ]

end

to end-game


  set gameInProgress 0

  ;;do anything else that ought to be done to finalize game files, etc.
  file-close
  ask patches with [inGame?] [ask turtles-here [die] set pcolor black]
end

to-report is-empty-safe? [ input ]
  ifelse is-list? input or is-string? input
    [ report empty? input ]
    [ report false ] ; Numbers, booleans, and agentsets return false
end

to-report detect-delimiter [filename]

  let comma-rows []
  let semicolon-rows []

  carefully [
    set comma-rows (csv:from-file filename ",")
  ] [ ]

  carefully [
    set semicolon-rows (csv:from-file filename ";")
  ] [ ]

  if empty? comma-rows and empty? semicolon-rows [
    error (word "Could not read CSV file: " filename)
  ]

  if empty? comma-rows [
    report ";"
  ]

  if empty? semicolon-rows [
    report ","
  ]

  if length first semicolon-rows > length first comma-rows [
    report ";"
  ]

  report ","
end


]]></code>
  <widgets>
